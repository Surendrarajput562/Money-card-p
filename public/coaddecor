<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Master Engine Terminal</title>
    <style>
        :root { --neon: #00f2ff; --gold: #ffcc00; }
        body { background: #080808; color: #fff; font-family: 'Segoe UI', sans-serif; padding: 30px; }
        .terminal { background: #111; border: 2px solid var(--neon); padding: 25px; border-radius: 15px; box-shadow: 0 0 20px var(--neon); }
        h1 { color: var(--gold); text-transform: uppercase; letter-spacing: 2px; }
        textarea, input { width: 100%; background: #000; border: 1px solid #333; color: var(--neon); padding: 15px; margin: 10px 0; border-radius: 5px; font-family: monospace; }
        button { background: var(--neon); color: #000; border: none; padding: 15px 30px; font-weight: bold; cursor: pointer; border-radius: 5px; width: 100%; font-size: 1.1em; transition: 0.3s; }
        button:hover { background: var(--gold); box-shadow: 0 0 15px var(--gold); }
        #status { margin-top: 15px; font-weight: bold; color: var(--gold); }
        iframe { width: 100%; height: 400px; border: 1px solid #333; margin-top: 20px; background: #fff; border-radius: 10px; display: none; }
    </style>
</head>
<body>

<div class="terminal">
    <h1>👨‍💻 Money-Card Master Engine</h1>
    <p>Target Page ID (e.g. <b>poli.html</b>)</p>
    <input type="text" id="pageId" placeholder="Konsi file ki surgery karni hai?">
    
    <p>Command (Be Specific)</p>
    <textarea id="command" rows="5" placeholder="Bhai, isme ek 'Apply Now' button daal, uska logic Firebase path 'leads' pe save kar, aur theme gold kar de..."></textarea>
    
    <button onclick="executeSurgery()">🚀 RUN MASTER ARCHITECT</button>
    
    <div id="status"></div>
    <iframe id="preview"></iframe>
</div>

<script>
    async function executeSurgery() {
        const btn = document.querySelector('button');
        const status = document.getElementById('status');
        const preview = document.getElementById('preview');
        
        const pageId = document.getElementById('pageId').value;
        const command = document.getElementById('command').value;

        if(!pageId || !command) return alert("Bhai data toh bhar!");

        btn.innerText = "SURGERY IN PROGRESS... 💉";
        status.innerText = "Engine code mein ghus raha hai...";

        try {
            const res = await fetch('https://money-card-p.vercel.app/api/engine/fixer', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ pageId, command })
            });
            const data = await res.json();

            if(data.success) {
                status.innerText = "Bhai, kaam ho gaya! Live Preview dekh le niche.";
                preview.style.display = "block";
                preview.srcdoc = data.fixed_code;
                btn.innerText = "🚀 RUN MASTER ARCHITECT";
            } else {
                status.innerText = "Error: " + data.message;
                btn.innerText = "RETRY SURGERY";
            }
        } catch (e) {
            status.innerText = "Bhai Vercel down hai ya URL galat hai!";
            btn.innerText = "FIX CONNECTION";
        }
    }
</script>
</body>
</html>


