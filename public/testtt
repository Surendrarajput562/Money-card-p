        // --- PRODUCTS & SHOP ---
        function loadProducts(){
            db.ref('products').on('value', snap => {
                productsData = snap.val() || {};
                
                // Process Data structure fixes
                Object.keys(productsData).forEach(k => {
                   let p = productsData[k];
                   if(typeof p.images === 'string') p.images = p.images.split(',');
                   else if(!Array.isArray(p.images)) p.images = [];
                   p.colors_list = Array.isArray(p.color) ? p.color : (p.color ? p.color.split(',') : []);
                   p.sizes_list = Array.isArray(p.size) ? p.size : (p.size ? p.size.split(',') : []);
                });
                
                renderProducts(Object.keys(productsData).reverse());
                
                // Render Home Categories
                db.ref('E_COMMERCE_CATEGORIES').once('value', cSnap => {
                    ecommerceCategories = cSnap.val() || {};
                    const scroll = document.getElementById('category-scroll-container'); scroll.innerHTML = '';
                    const select = document.getElementById('cat-shop-filter'); select.innerHTML = '<option value="">All Categories</option>';
                    
                    Object.keys(ecommerceCategories).forEach(cat => {
                        if(cat === 'General') return;
                        // Scroll Item
                        const div = document.createElement('div'); div.className = 'cat-chip';
                        div.innerHTML = `<img class="cat-img" src="https://via.placeholder.com/60?text=${cat.substring(0,1)}"><span class="cat-name">${cat}</span>`;
                        div.onclick = () => { document.getElementById('cat-shop-filter').value=cat; searchShop(true); showTab('shop'); };
                        scroll.appendChild(div);
                        
                        // Select Option
                        const opt = document.createElement('option'); opt.value = cat; opt.innerText = cat;
                        select.appendChild(opt);
