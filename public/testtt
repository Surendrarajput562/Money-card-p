<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no" />
    <title>Gold Rupi - Premium User</title>
    
    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet">
    
    <style>
        /* --- THEME VARIABLES --- */
        :root {
            --primary: #d4af37;
            --primary-dark: #b59020;
            --primary-light: #f3e5ab;
            --bg-body: #f8f9fa;
            --bg-card: #ffffff;
            --text-main: #1f2937;
            --text-muted: #6b7280;
            --shadow: 0 4px 20px rgba(0,0,0,0.06);
            --radius: 16px;
        }
        [data-theme="dark"] {
            --bg-body: #111827;
            --bg-card: #1f2937;
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
            --shadow: 0 4px 20px rgba(0,0,0,0.4);
        }

        /* --- BASE STYLES --- */
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        body { margin: 0; font-family: 'Poppins', sans-serif; background: var(--bg-body); color: var(--text-main); padding-bottom: 80px; transition: 0.3s; }
        
        /* --- HEADER --- */
        .header {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            padding: 12px 16px;
            position: sticky; top: 0; z-index: 1000;
            display: flex; justify-content: space-between; align-items: center;
            box-shadow: 0 1px 10px rgba(0,0,0,0.05);
        }
        [data-theme="dark"] .header { background: rgba(31, 41, 55, 0.95); }
        
        .brand { display: flex; align-items: center; gap: 10px; }
        .logo { 
            width: 40px; height: 40px; background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            border-radius: 10px; display: flex; align-items: center; justify-content: center;
            color: #fff; font-weight: 800; font-size: 18px;
        }
        .header-icons { display: flex; gap: 15px; align-items: center; }
        .icon-btn { font-size: 22px; color: var(--text-main); position: relative; cursor: pointer; }
        .cart-badge { position: absolute; top: -5px; right: -5px; background: red; color: white; font-size: 10px; width: 16px; height: 16px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; }

        /* --- COMPONENTS --- */
        .container { padding: 16px; }
        .section { display: none; animation: fadeIn 0.3s ease; }
        .section.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        .card { background: var(--bg-card); border-radius: var(--radius); padding: 16px; box-shadow: var(--shadow); margin-bottom: 16px; position: relative; }
        
        .btn { 
            background: var(--primary); color: #000; border: none; padding: 12px; 
            border-radius: 12px; font-weight: 600; width: 100%; cursor: pointer; font-size: 14px;
        }
        .btn:active { transform: scale(0.98); }
        .btn.secondary { background: transparent; border: 1px solid var(--text-muted); color: var(--text-main); }
        .btn.outline { background: transparent; border: 1px solid var(--primary); color: var(--primary-dark); }

        input, select, textarea {
            width: 100%; padding: 12px; border-radius: 10px; border: 1px solid #ddd;
            background: var(--bg-body); color: var(--text-main); font-family: inherit; margin-bottom: 10px; outline: none;
        }
        [data-theme="dark"] input { border-color: #374151; }

        /* --- PROFILE SPECIAL STYLES (UPGRADED) --- */
        .profile-header-card {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: #fff; text-align: center; padding: 30px 20px; border-radius: 0 0 24px 24px;
            margin: -16px -16px 20px -16px; box-shadow: 0 10px 30px rgba(212, 175, 55, 0.3);
        }
        .profile-pic-container { position: relative; width: 90px; height: 90px; margin: 0 auto 12px; }
        .profile-img { width: 100%; height: 100%; border-radius: 50%; border: 3px solid #fff; object-fit: cover; background: #fff; }
        .edit-badge { position: absolute; bottom: 0; right: 0; background: #333; color: #fff; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 14px; border: 2px solid #fff; cursor: pointer;}
        
        .profile-name { font-size: 20px; font-weight: 700; margin-bottom: 4px; }
        .profile-meta { font-size: 13px; opacity: 0.9; }

        .stats-row { display: flex; gap: 12px; margin-top: -40px; margin-bottom: 20px; padding: 0 10px; }
        .stat-card { flex: 1; background: var(--bg-card); padding: 15px; border-radius: 16px; text-align: center; box-shadow: var(--shadow); }
        .stat-val { font-size: 18px; font-weight: 700; color: var(--primary-dark); }
        .stat-label { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }

        .menu-list { list-style: none; padding: 0; margin: 0; }
        .menu-item { 
            display: flex; align-items: center; gap: 15px; padding: 15px; 
            border-bottom: 1px solid rgba(0,0,0,0.05); cursor: pointer; transition: 0.2s;
        }
        .menu-item:last-child { border-bottom: none; }
        .menu-item:active { background: rgba(0,0,0,0.02); }
        .menu-icon { 
            width: 36px; height: 36px; background: var(--primary-light); 
            color: var(--primary-dark); border-radius: 10px; display: flex; 
            align-items: center; justify-content: center; font-size: 18px; 
        }
        .menu-text { flex: 1; font-weight: 500; font-size: 14px; }
        .menu-arrow { color: var(--text-muted); }

        /* --- HOME GRID --- */
        .category-scroll { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 10px; scrollbar-width: none; }
        .cat-chip { display: flex; flex-direction: column; align-items: center; min-width: 70px; }
        .cat-img { width: 60px; height: 60px; border-radius: 50%; object-fit: cover; border: 2px solid var(--primary); padding: 2px; margin-bottom: 5px; }
        .cat-name { font-size: 11px; font-weight: 600; text-align: center; }

        .product-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
        .product-card { background: var(--bg-card); border-radius: 12px; padding: 10px; box-shadow: var(--shadow); }
        .product-img { width: 100%; height: 140px; object-fit: cover; border-radius: 8px; margin-bottom: 8px; }
        .p-price { color: var(--primary-dark); font-weight: 700; }

        /* --- SERVICES GRID --- */
        .service-grid-box { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; padding: 10px 0; }
        .service-item { display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; cursor: pointer; }
        .service-icon-box { 
            width: 50px; height: 50px; background: #fff; border: 1px solid #eee;
            border-radius: 14px; display: flex; align-items: center; justify-content: center; 
            font-size: 24px; color: var(--primary); box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
        .service-name { font-size: 11px; font-weight: 500; line-height: 1.2; }

        /* --- BOTTOM NAV --- */
        .bottom-nav {
            position: fixed; bottom: 0; left: 0; right: 0; height: 70px;
            background: var(--bg-card); display: flex; justify-content: space-around;
            align-items: center; box-shadow: 0 -2px 20px rgba(0,0,0,0.05); z-index: 999;
            border-top-left-radius: 20px; border-top-right-radius: 20px;
        }
        .nav-item { display: flex; flex-direction: column; align-items: center; color: var(--text-muted); font-size: 10px; gap: 4px; width: 20%; }
        .nav-item i { font-size: 22px; transition: 0.2s; }
        .nav-item.active { color: var(--primary-dark); font-weight: 600; }
        .nav-item.active i { transform: translateY(-3px); }

        /* --- MODALS --- */
        .overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 2000; display: none; align-items: center; justify-content: center; backdrop-filter: blur(4px); }
        .modal { background: var(--bg-card); width: 90%; max-width: 500px; max-height: 90vh; overflow-y: auto; border-radius: 20px; padding: 20px; animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
        @keyframes slideUp { from { transform: translateY(50px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        
        /* Status Badges */
        .badge { padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; color: #fff; text-transform: uppercase; }
        .badge.pending { background: #f59e0b; }
        .badge.success { background: #10b981; }
        .badge.failed { background: #ef4444; }

    </style>
</head>
<body data-theme="light">

    <!-- Header -->
    <div class="header">
        <div class="brand">
            <div class="logo">GR</div>
            <div>
                <div style="font-weight:700; line-height:1.1;">Gold Rupi</div>
                <div style="font-size:10px; opacity:0.7;">Premium Store</div>
            </div>
        </div>
        <div class="header-icons">
            <div class="small" id="gold-rate-ticker">₹6500/g</div>
            <i class="ri-sun-line icon-btn" onclick="toggleTheme()" id="theme-icon"></i>
            <div class="icon-btn" onclick="showTab('cart')">
                <i class="ri-shopping-bag-3-line"></i>
                <div id="cart-count" class="cart-badge" style="display:none">0</div>
            </div>
        </div>
    </div>

    <!-- MAIN CONTAINER -->
    <div class="container">

        <!-- ================= HOME SECTION ================= -->
        <div id="home" class="section active">
            <div style="margin-bottom: 15px;">
                <h2 style="margin:0; font-size: 22px;">Hello, <span id="welcome-name" style="color:var(--primary-dark);">User</span> 👋</h2>
                <div id="signup-bonus-note" style="font-size:12px; color:#10b981;"></div>
            </div>

            <!-- Gold Rate Card -->
            <div class="card" style="background: linear-gradient(90deg, #fff7e1, #fff); border-left: 4px solid var(--primary);">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <div>
                        <div style="font-size:12px; text-transform:uppercase; color:#888;">Live Gold Rate</div>
                        <div style="font-size:24px; font-weight:800; color:var(--primary-dark);">₹ <span id="gold-rate">6500</span> <span style="font-size:14px;">/g</span></div>
                        <div style="font-size:11px; margin-top:4px;">Your Balance: <strong id="gold-balance-display">0.0000</strong> g</div>
                    </div>
                    <button class="btn" style="width:auto; padding: 8px 16px;" onclick="showTab('gold')">Buy Gold</button>
                </div>
            </div>

            <!-- Categories -->
            <h3 style="font-size:16px; margin: 20px 0 10px;">Categories</h3>
            <div id="category-scroll-container" class="category-scroll">
                <!-- Javascript will load categories here -->
            </div>

            <!-- Products -->
            <h3 style="font-size:16px; margin: 20px 0 10px;">Trending Now</h3>
            <div id="latest-products" class="product-grid">
                <!-- Javascript will load products here -->
            </div>
        </div>

        <!-- ================= SHOP SECTION ================= -->
        <div id="shop" class="section">
            <h2 style="margin-top:0">Explore Shop</h2>
            <div class="card" style="position:sticky; top:70px; z-index:90;">
                <div style="display:flex; gap:10px;">
                    <input id="search-shop" placeholder="Search products..." style="margin:0; background:#f1f1f1;">
                    <button class="btn" style="width:50px;" onclick="searchShop(true)"><i class="ri-search-line"></i></button>
                </div>
                <select id="cat-shop-filter" onchange="searchShop(true)" style="margin-top:10px; margin-bottom:0;">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div id="product-list" class="product-grid" style="margin-top:15px"></div>
        </div>

        <!-- ================= CART SECTION ================= -->
        <div id="cart" class="section">
            <h2 style="margin-top:0">My Cart</h2>
            <div id="cart-list" style="margin-bottom:80px;"></div>
            
            <div class="card" style="position:fixed; bottom:70px; left:16px; right:16px; margin:0; box-shadow: 0 -5px 20px rgba(0,0,0,0.1);">
                <div style="display:flex; justify-content:space-between; margin-bottom:10px; font-weight:700;">
                    <span>Total Amount</span>
                    <span>₹ <span id="cart-subtotal">0</span></span>
                </div>
                <div style="display:flex; gap:10px;">
                    <button class="btn secondary" onclick="clearCart()" style="flex:1">Clear</button>
                    <button class="btn" onclick="openCheckoutModal()" style="flex:2">Checkout</button>
                </div>
            </div>
        </div>

        <!-- ================= GOLD & WALLET SECTION (Combined Logic) ================= -->
        <div id="gold" class="section">
            <h2 style="margin-top:0">Digital Gold</h2>
            <div class="card" style="text-align:center; padding:30px;">
                <div style="font-size:12px; color:#888;">Current Holding</div>
                <div style="font-size:32px; font-weight:800; color:var(--primary-dark); margin:5px 0;"><span id="gold-balance-main">0.0000</span> g</div>
                <div style="font-size:14px;">Worth: ₹ <span id="gold-value-main">0</span></div>
            </div>

            <div class="card">
                <h3>Buy Gold</h3>
                <input id="gold-amount" type="number" placeholder="Enter Amount (₹)">
                <div style="display:flex; justify-content:space-between; font-size:12px; margin-bottom:15px; color:#666;">
                    <span>Min: ₹50</span>
                    <span>You get: <strong id="gold-grams-calc">0.0000</strong> g</span>
                </div>
                <button class="btn" onclick="buyGold()">Proceed to Pay</button>
            </div>

            <div class="card" style="margin-top:10px;">
                <div style="display:flex; justify-content:space-between; align-items:center;" onclick="toggleHistory('gold-hist')">
                    <strong>Transaction History</strong> <i class="ri-arrow-down-s-line"></i>
                </div>
                <div id="gold-hist" style="display:none; margin-top:10px;">
                    <div id="gold-status-list"></div>
                </div>
            </div>
        </div>

        <div id="wallet" class="section">
            <h2 style="margin-top:0">My Wallet</h2>
            <div class="card" style="background:var(--text-main); color:var(--bg-card); padding:25px;">
                <div style="opacity:0.8; font-size:12px;">Available Balance</div>
                <div style="font-size:32px; font-weight:700;">₹ <span id="wallet-balance-main">0.00</span></div>
            </div>

            <div class="card">
                <h3>Add Money</h3>
                <input id="wallet-add-amount" type="number" placeholder="Amount (₹)">
                <button class="btn" onclick="addWallet()">Add Money</button>
                <div style="margin-top:10px; text-align:center;">
                    <button class="btn secondary" style="width:auto; padding:8px 20px;" onclick="openWithdrawModal()">Withdraw Money</button>
                </div>
            </div>
             <div id="wallet-history-list" style="margin-top:10px;"></div>
        </div>

        <!-- ================= PROFILE SECTION (UPGRADED) ================= -->
        <div id="profile" class="section" style="padding:0;">
            <!-- 1. Hero Header -->
            <div class="profile-header-card">
                <div style="display:flex; justify-content:flex-end;">
                   <i class="ri-logout-box-r-line" onclick="logout()" style="font-size:20px; cursor:pointer;"></i>
                </div>
                <div class="profile-pic-container">
                    <img id="profile-photo" class="profile-img" src="https://via.placeholder.com/100" alt="Profile">
                    <div class="edit-badge" onclick="toggleProfileEdit()"><i class="ri-pencil-line"></i></div>
                </div>
                <div class="profile-name" id="profile-name-display">User Name</div>
                <div class="profile-meta" id="profile-mobile-display">+91 0000000000</div>
                <div class="profile-meta" id="profile-email-display">email@example.com</div>
            </div>

            <!-- 2. Stats Row -->
            <div class="stats-row">
                <div class="stat-card" onclick="showTab('wallet')">
                    <div class="stat-val">₹<span id="profile-wallet-bal">0</span></div>
                    <div class="stat-label">Wallet</div>
                </div>
                <div class="stat-card" onclick="showTab('gold')">
                    <div class="stat-val"><span id="profile-gold-bal">0.0</span>g</div>
                    <div class="stat-label">Gold</div>
                </div>
            </div>

            <div class="container">
                <!-- 3. Services Grid (App Style) -->
                <div class="card">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                        <h3 style="margin:0; font-size:16px;">Services</h3>
                        <span style="font-size:12px; color:var(--primary-dark); cursor:pointer;" onclick="toggleServices()" id="srv-toggle-txt">Show All</span>
                    </div>
                    
                    <div id="servicesBox" style="display:block;"> <!-- Default show limited, toggle logic handles scroll/height -->
                        <div id="serviceGrid" class="service-grid-box">
                             <!-- Example Static Items - Logic will fill visibility -->
                            <div class="service-item" id="service1" data-href="loan.html">
                                <div class="service-icon-box"><i class="ri-money-dollar-circle-line"></i></div>
                                <div class="service-name">Loan</div>
                            </div>
                            <div class="service-item" id="service2" data-href="ebook.html">
                                <div class="service-icon-box"><i class="ri-book-open-line"></i></div>
                                <div class="service-name">E-Books</div>
                            </div>
                            <div class="service-item" id="service3" data-href="uapp.html">
                                <div class="service-icon-box"><i class="ri-apps-line"></i></div>
                                <div class="service-name">Apps</div>
                            </div>
                            <div class="service-item" onclick="openCryptoExchangeModal()">
                                <div class="service-icon-box"><i class="ri-bit-coin-line"></i></div>
                                <div class="service-name">Crypto</div>
                            </div>
                             <!-- More placeholders for dynamic loading -->
                        </div>
                    </div>
                </div>

                <!-- 4. Menu List -->
                <div class="card" style="padding:0; overflow:hidden;">
                    <ul class="menu-list">
                        <li class="menu-item" onclick="showHistory('orders')">
                            <div class="menu-icon"><i class="ri-shopping-bag-3-fill"></i></div>
                            <div class="menu-text">My Orders</div>
                            <i class="ri-arrow-right-s-line menu-arrow"></i>
                        </li>
                        <li class="menu-item" onclick="toggleAddressEdit()">
                            <div class="menu-icon"><i class="ri-map-pin-user-fill"></i></div>
                            <div class="menu-text">Saved Address</div>
                            <i class="ri-arrow-right-s-line menu-arrow"></i>
                        </li>
                        <li class="menu-item" onclick="document.getElementById('kyc-modal').style.display='flex'">
                            <div class="menu-icon"><i class="ri-shield-user-fill"></i></div>
                            <div class="menu-text">KYC Verification</div>
                            <i class="ri-arrow-right-s-line menu-arrow"></i>
                        </li>
                        <li class="menu-item" onclick="document.getElementById('refer-modal').style.display='flex'">
                            <div class="menu-icon"><i class="ri-gift-2-fill"></i></div>
                            <div class="menu-text">Refer & Earn</div>
                            <i class="ri-arrow-right-s-line menu-arrow"></i>
                        </li>
                        <li class="menu-item" onclick="document.getElementById('chat-modal').style.display='flex'">
                            <div class="menu-icon"><i class="ri-customer-service-2-fill"></i></div>
                            <div class="menu-text">Help & Support</div>
                            <i class="ri-arrow-right-s-line menu-arrow"></i>
                        </li>
                    </ul>
                </div>
                
                <div id="orders-full-list"></div>
            </div>
        </div>

    </div> <!-- End Container -->

    <!-- ================= MODALS ================= -->

    <!-- Edit Profile Modal -->
    <div id="profile-edit-modal" class="overlay">
        <div class="modal">
            <h3>Edit Profile</h3>
            <label class="small">Full Name</label>
            <input id="profile-name" placeholder="Name">
            <label class="small">Email</label>
            <input id="profile-email" placeholder="Email">
            <label class="small">Profile Photo</label>
            <input type="file" id="profile-upload">
            <div style="display:flex; gap:10px; margin-top:15px;">
                <button class="btn" onclick="saveProfile()">Save Changes</button>
                <button class="btn secondary" onclick="document.getElementById('profile-edit-modal').style.display='none'">Cancel</button>
            </div>
            <button class="btn outline" style="margin-top:10px" onclick="uploadProfile()">Upload New Photo</button>
        </div>
    </div>

    <!-- Address Modal -->
    <div id="address-modal" class="overlay">
        <div class="modal">
            <h3>Manage Address</h3>
            <div id="address-view-card" class="card" style="background:#f9f9f9;">
                <p id="address-display" style="font-size:13px; color:#555;">No address saved.</p>
            </div>
            <hr style="border:0; border-top:1px solid #eee; margin:15px 0;">
            <h4>Update Address</h4>
            <label class="small">House/Flat No, Street</label>
            <input id="addr-house" placeholder="e.g. 101, Main Road">
            <div style="display:flex; gap:10px;">
                <div><label class="small">City</label><input id="addr-city"></div>
                <div><label class="small">Pincode</label><input id="addr-pincode" type="number"></div>
            </div>
            <div style="display:flex; gap:10px;">
                <div><label class="small">State</label><input id="addr-state"></div>
                <div><label class="small">Country</label><input id="addr-country" value="India" readonly></div>
            </div>
            <div style="display:flex; gap:10px; margin-top:15px;">
                <button class="btn" onclick="saveAddress()">Save Address</button>
                <button class="btn secondary" onclick="document.getElementById('address-modal').style.display='none'">Close</button>
            </div>
        </div>
    </div>

    <!-- Checkout Modal (Shiprocket Compatible) -->
    <div id="checkout-overlay" class="overlay">
        <div class="modal">
            <h3 style="border-bottom:1px solid #eee; padding-bottom:10px;">Checkout</h3>
            <div id="checkout-items" style="max-height:120px; overflow-y:auto; margin-bottom:15px; font-size:13px;"></div>
            
            <div style="background: #f8f9fa; padding: 15px; border-radius: 12px;">
                <h4 style="margin:0 0 10px 0; font-size:14px; color:var(--primary-dark);">Shipping Details</h4>
                <input id="co-name" placeholder="Receiver Name">
                <input id="co-mobile" type="number" placeholder="Mobile (10 digits)">
                <input id="co-addr-house" placeholder="Full Address">
                <div style="display:flex; gap:10px;">
                    <input id="co-addr-pincode" type="number" placeholder="Pincode">
                    <input id="co-addr-city" placeholder="City">
                </div>
                <input id="co-addr-state" placeholder="State">
            </div>

            <div style="display:flex; gap:10px; margin-top:15px;">
                <button class="btn" onclick="confirmCheckout()"><i class="ri-secure-payment-line"></i> Pay Now</button>
                <button class="btn secondary" onclick="closeCheckoutModal()">Cancel</button>
            </div>
        </div>
    </div>

    <!-- Product Details Modal -->
    <div id="product-overlay" class="overlay">
        <div class="modal">
