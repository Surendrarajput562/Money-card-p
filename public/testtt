        function renderProducts(keys) {
            const list = document.getElementById('product-list'); 
            const homeList = document.getElementById('latest-products');
            list.innerHTML = ''; homeList.innerHTML = '';
            
            keys.forEach((k, index) => {
                const p = productsData[k];
                const price = p.discount ? Math.round(p.price * (100 - p.discount)/100) : p.price;
                
                const html = `
                    <div class="product-card">
                        <img src="${(p.images && p.images[0]) || ''}" class="product-img">
                        <div style="font-weight:600; font-size:13px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${p.name}</div>
                        <div class="p-price">₹${price}</div>
                        <button class="btn outline" style="padding:6px; margin-top:8px;" onclick="openProductModal('${k}')">View</button>
                    </div>
                `;
                
                list.innerHTML += html;
                if(index < 4) homeList.innerHTML += html;
            });
        }
        
        function searchShop(filter){
            const txt = document.getElementById('search-shop').value.toLowerCase();
            const cat = document.getElementById('cat-shop-filter').value;
            const keys = Object.keys(productsData).filter(k => {
                const p = productsData[k];
                if(cat && p.category !== cat) return false;
                return !txt || p.name.toLowerCase().includes(txt);
            });
            renderProducts(keys);
        }

        function openProductModal(id){
            const p = productsData[id]; modalProductId = id;
            document.getElementById('modal-title').innerText = p.name;
            const price = p.discount ? Math.round(p.price * (100 - p.discount)/100) : p.price;
            document.getElementById('modal-price').innerText = `₹${price}`;
            document.getElementById('modal-desc').innerText = p.description || 'No description';
            
            const imgs = document.getElementById('modal-images'); imgs.innerHTML = '';
            (p.images || []).forEach(url => {
               imgs.innerHTML += `<img src="${url}" style="width:80px; height:80px; border-radius:8px; object-fit:cover;">`; 
            });
            
            const cSel = document.getElementById('modal-color-select');
            const sSel = document.getElementById('modal-size-select');
            cSel.innerHTML = '<option value="">Select Color</option>';
            sSel.innerHTML = '<option value="">Select Size</option>';
            
            (p.colors_list || []).forEach(c => cSel.innerHTML += `<option value="${c}">${c}</option>`);
            (p.sizes_list || []).forEach(s => sSel.innerHTML += `<option value="${s}">${s}</option>`);
            
            document.getElementById('modal-add-to-cart-btn').disabled = false; // Simplified for UX
            document.getElementById('product-overlay').style.display = 'flex';
        }
        
        function closeOverlay() { document.querySelectorAll('.overlay').forEach(o => o.style.display = 'none'); }

        // --- CART ---
        function modalAddToCart(){
            const c = document.getElementById('modal-color-select').value || 'Default';
            const s = document.getElementById('modal-size-select').value || 'Default';
            const k = `${modalProductId}_${c}_${s}`;
            
            if(!cart[k]) cart[k] = { qty:1, color:c, size:s, productId:modalProductId };
            else cart[k].qty++;
            
            db.ref('carts/'+currentUser.uid).set(cart);
            closeOverlay();
            alert('Added to Cart');
        }
        
        function loadCart(){
            db.ref('carts/'+currentUser.uid).on('value', snap => {
                cart = snap.val() || {};
                const list = document.getElementById('cart-list'); list.innerHTML = '';
                let total = 0; let count = 0;
                
                Object.keys(cart).forEach(k => {
                    const item = cart[k];
                    const p = productsData[item.productId];
                    if(!p) return;
                    
                    const price = p.discount ? Math.round(p.price * (100 - p.discount)/100) : p.price;
                    total += price * item.qty;
                    count += item.qty;
                    
                    list.innerHTML += `
                        <div class="card" style="display:flex; gap:10px; align-items:center;">
                            <img src="${(p.images&&p.images[0])||''}" style="width:60px; height:60px; border-radius:8px; object-fit:cover;">
                            <div style="flex:1;">
                                <div style="font-weight:600; font-size:14px;">${p.name}</div>
                                <div style="font-size:12px; color:#777;">${item.color}/${item.size}</div>
                                <div style="font-weight:700;">₹${price * item.qty}</div>
                            </div>
                            <div style="display:flex; gap:5px; align-items:center;">
                                <button class="btn secondary" style="padding:5px 10px;" onclick="updateCart('${k}', -1)">-</button>
                                <span style="font-size:13px;">${item.qty}</span>
                                <button class="btn secondary" style="padding:5px 10px;" onclick="updateCart('${k}', 1)">+</button>
                            </div>
                        </div>
                    `;
                });
                
                document.getElementById('cart-subtotal').innerText = total;
                const badge = document.getElementById('cart-count');
                badge.innerText = count;
                badge.style.display = count > 0 ? 'flex' : 'none';
            });
        }
        function updateCart(k, change){
            if(cart[k].qty + change <= 0) delete cart[k];
            else cart[k].qty += change;
            db.ref('carts/'+currentUser.uid).set(cart);
        }
        function clearCart(){ db.ref('carts/'+currentUser.uid).remove(); }

        // --- CHECKOUT (SHIPROCKET LOGIC) ---
        async function openCheckoutModal(){
            if(!Object.keys(cart).length) return alert('Cart is empty');
            
            // Render Items Summary
            const list = document.getElementById('checkout-items'); list.innerHTML = '';
            Object.values(cart).forEach(i => {
                const p = productsData[i.productId];
                list.innerHTML += `<div style="display:flex; justify-content:space-between; border-bottom:1px solid #eee; padding:5px 0;"><span>${p.name} (x${i.qty})</span><span>${i.color}</span></div>`;
            });
            
            // Pre-fill
            const u = currentProfileData;
            const a = u.address || {};
            document.getElementById('co-name').value = u.name || '';
            document.getElementById('co-mobile').value = u.mobile || '';
            document.getElementById('co-addr-house').value = a.address_line1 || '';
            document.getElementById('co-addr-city').value = a.city || '';
            document.getElementById('co-addr-pincode').value = a.pincode || '';
            document.getElementById('co-addr-state').value = a.state || '';
            
            document.getElementById('checkout-overlay').style.display = 'flex';
        }
        
        async function confirmCheckout(){
            const name = document.getElementById('co-name').value;
            const mobile = document.getElementById('co-mobile').value;
            const house = document.getElementById('co-addr-house').value;
            const pincode = document.getElementById('co-addr-pincode').value;
            const city = document.getElementById('co-addr-city').value;
            const state = document.getElementById('co-addr-state').value;
            
            if(!name || !mobile || !house || !pincode || !city || !state) return alert('All Shipping fields are required');
            if(pincode.length !== 6) return alert('Invalid Pincode');
            if(mobile.length !== 10) return alert('Invalid Mobile');
            
            // Save Address First
            const finalAddr = { address_line1: house, city, state, pincode, country: 'India' };
            await db.ref('users/'+currentUser.uid).update({ mobile });
            await db.ref('users/'+currentUser.uid+'/address').set(finalAddr);
            
            const subtotal = Number(document.getElementById('cart-subtotal').innerText);
            const orderId = 'o' + Date.now();
            
            const items = {};
            Object.keys(cart).forEach(k => {
               const i = cart[k]; const p = productsData[i.productId];
               const pr = p.discount ? Math.round(p.price * (100 - p.discount)/100) : p.price;
               items[k] = {
                   id: i.productId, name: p.name, quantity: i.qty,
                   price: Number(p.price), final_price: pr,
                   image: (p.images && p.images[0]) || '',
                   color: i.color, size: i.size, sku: p.sku || i.productId
               };
            });
            
            try {
                const res = await axios.post(CREATE_ORDER_BACKEND_URL, {
                    type: 'cart',
                    internal_id: orderId,
                    txn_amount: subtotal,
                    txn_note: `Order ${orderId}`,
                    customer_name: name, customer_mobile: mobile,
                    customer_email: currentProfileData.email || 'noemail@domain.com',
                    redirect_url: ALLAPI_REDIRECT_URL,
                    user_uid: currentUser.uid,
                    order_address: finalAddr,
                    order_items: items
                });
                
                if(!res.data.success) throw new Error(res.data.message);
                
                const payload = {
                    id: orderId, user: currentUser.uid, items, total: subtotal,
                    status: 'pending', created_at: Date.now(),
                    billing_customer_name: name, billing_phone: mobile,
                    billing_address: house, billing_city: city, billing_pincode: pincode, billing_state: state,
                    billing_country: 'India', shipping_is_billing: true
                };
                
                await db.ref('orders/'+orderId).set(payload);
                await db.ref('users/'+currentUser.uid+'/order_history/'+orderId).set(payload);
                
                clearCart();
                document.getElementById('checkout-overlay').style.display = 'none';
                
                if(res.data.results && res.data.results.payment_session_id){
                    const cf = Cashfree({ mode: "production" });
                    cf.checkout({ paymentSessionId: res.data.results.payment_session_id, redirectUrl: ALLAPI_REDIRECT_URL + "?order_id=" + orderId });
                }
                
            } catch(e) { alert('Checkout Error: ' + e.message); console.log(e); }
        }

        // --- OTHER LOGIC (Gold, Wallet, History) - Simplified for brevity but functional ---
        function renderKYC(k){
            const b = document.getElementById('kyc-block');
