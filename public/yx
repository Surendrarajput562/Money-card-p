                                        }
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                    
                    const remainingEmis = emiArray.filter(e => e.status !== 'paid').length;
                    if (remainingEmis === 0 && loanDetails.status === 'approved') { // Check if all paid and loan is not yet closed
