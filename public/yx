        function listenPaymentRequests(){
            // Make sure this listener is only set up once.
            // Using `off` before `on` ensures a clean state if called multiple times.
            paymentRequestsRef.off('child_changed', handlePaymentRequest);
            paymentRequestsRef.on('child_changed', handlePaymentRequest);
