// --- [A] SEEDHA SHARE LOGIC ---
function shareProduct(pid, pname) {
    // Sirf kaam ki cheez: URL aur Message
    const shareUrl = `${window.location.origin}${window.location.pathname}?pid=${pid}`;
    const msg = `Check out ${pname} on Gold Rupi: ${shareUrl}`;

    if (navigator.share) {
        navigator.share({ title: pname, text: msg, url: shareUrl }).catch(() => {
            navigator.clipboard.writeText(shareUrl); // Cancel pe copy
        });
    } else {
        navigator.clipboard.writeText(shareUrl); // Desktop pe copy
    }
}

