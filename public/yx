        // Category & Filter helpers
        function populateCategoriesDropdowns(){
            const cats = new Set();
            // Collect categories from productsData
            Object.values(productsData || {}).forEach(p=>{
                if(p && p.category) cats.add(p.category);
            });
            // Also collect from E_COMMERCE_CATEGORIES (main categories only for dropdown)
            for (const mainCatKey in ecommerceCategories) {
                if (mainCatKey !== 'General' && typeof ecommerceCategories[mainCatKey] === 'object' && ecommerceCategories[mainCatKey] !== null) {
                    cats.add(mainCatKey);
                    // Add subcategories too, if desired for filtering directly
                    for (const subCatKey in ecommerceCategories[mainCatKey]) {
                        if (ecommerceCategories[mainCatKey][subCatKey] === true) {
                            cats.add(subCatKey);
                        }
                    }
                }
            }

            const sel = document.getElementById('category-filter');
            const sel2 = document.getElementById('cat-shop-filter'); 

            [sel, sel2].forEach(s=>{
                if(!s) return;

                const currentSelectedValue = s.value; // Remember current selection
                s.innerHTML = '<option value="">all categories</option>';

                const sortedCats = Array.from(cats).sort(); // Sort categories alphabetically

                sortedCats.forEach(catId=>{
                    const opt = document.createElement('option');
                    opt.value = catId;
                    opt.innerText = catId.replace(/_/g, ' '); // Use key, replace underscores
                    s.appendChild(opt);
                });

                s.value = currentSelectedValue; // Restore previous selection
            });
