function handleSharedProductLink() {
    const p = new URLSearchParams(window.location.search).get('pid');
    if (p) {
        const wait = setInterval(() => {
            if (window.productsData && productsData[p]) {
                clearInterval(wait);
                openProductModal(p);
                window.history.replaceState({}, '', window.location.pathname);
            }
        }, 500);
        setTimeout(() => clearInterval(wait), 8000);
    }
}




        // ---------- listen to payment_requests (Admin verifications) (Unchanged logic) ----------
        function listenPaymentRequests(){
            // Make sure this listener is only set up once.
            // Using `off` before `on` ensures a clean state if called multiple times.
            paymentRequestsRef.off('child_changed', handlePaymentRequest);
            paymentRequestsRef.on('child_changed', handlePaymentRequest);
        }

        // Modified handlePaymentRequest to work with allapi.in's flow
        function handlePaymentRequest(snap){
            const pr = snap.val();
            // Only process if it's for the current user and not an internal allapi.in pending status
            if(!pr || !currentUser || pr.user !== currentUser.uid || pr.status === 'allapi_pending') return; 

            const uid = pr.user;
            const key = pr.id; // Use 'id' which links to internal Firebase object (order, gold_request, wallet_request)
            
            // Expected status from backend webhook: 'completed', 'paid', 'success', 'approved'
            if(!['completed', 'paid', 'success', 'approved'].includes(pr.status)) return;

            // GOLD
            if(pr.type==='gold'){
                db.ref('users/'+uid+'/gold_history/'+key).once('value').then(s=>{
                    const g = s.val();
                    if(!g || g.status==='completed') return;

                    db.ref('users/'+uid+'/gold_history/'+key+'/status').set('completed');
                    
                    const grams = Number(g.grams || (g.amount / GOLD_RATE)).toFixed(4);
                    db.ref('users/'+uid+'/gold_balance').transaction(curr => Number(curr||0) + Number(grams));
                    
                    checkReferralCompletion(uid);
                    alert(`✅ Gold purchase of ${grams}g completed!`);
                }).catch(e => console.error("Error processing gold payment request:", e));
            }

            // WALLET (Add Money)
            if(pr.type==='wallet_add'){ // Use wallet_add type
                db.ref('users/'+uid+'/wallet_history/'+key).once('value').then(h=>{
                    if(!h.exists() || h.val().status==='completed') return;

                    db.ref('users/'+uid+'/wallet').transaction(curr => Number(curr||0) + Number(pr.amount));
                    db.ref('users/'+uid+'/wallet_history/'+key+'/status').set('completed');
                    alert(`✅ ₹${pr.amount} added to your wallet!`);
                }).catch(e => console.error("Error processing wallet add payment request:", e));
            }

            // WALLET (Withdrawal Approval - This still uses manual admin approval, not allapi.in)
            if(pr.type==='withdraw'){
                 db.ref('users/'+uid+'/wallet_history/'+key).once('value').then(h=>{
                    if(!h.exists() || h.val().status==='completed') return;

                    db.ref('users/'+uid+'/wallet_history/'+key+'/status').set('completed');
                    alert(`✅ ₹${pr.amount} withdrawal processed to your account.`);
                }).catch(e => console.error("Error processing withdrawal payment request:", e));
            }

            // CART (Order Payment)
            if(pr.type==='cart'){
                const orderId = pr.id; // Use 'id' which links to Firebase internal order ID
                db.ref('orders/'+orderId+'/status').set('paid');
                db.ref('users/'+uid+'/order_history/'+orderId+'/status').set('paid');
                alert(`✅ Order #${orderId.substring(0,8)}... payment completed!`);
            }

            // LOAN EMI PAYMENT (This still uses manual UTR, not allapi.in)
            if(pr.type === 'emi_payment'){
                 db.ref('users/'+uid+'/loan_emis/'+pr.emiId+'/status').set('paid');
                 alert(`✅ EMI payment for ${pr.emiId.substring(0,8)}... completed!`);
            }
        }
        
        async function checkReferralCompletion(userId){
            const userSnap = await db.ref('users/'+userId).once('value');
            const userData = userSnap.val();
            const referrerId = userData.referred_by; 

            if (!referrerId) return;

            const refReqSnap = await db.ref('refer_cash_requests').orderByChild('mobile').equalTo(userData.mobile).once('value');
            const refReq = refReqSnap.val();
            
            if(!refReq) return; 
            
            const refReqId = Object.keys(refReq)[0];
            const requestData = refReq[refReqId];
            
            if(requestData.status === 'completed' || requestData.status === 'eligible_for_bonus') return;

            const goldHistorySnap = await db.ref('users/'+userId+'/gold_history').once('value');
            const firstGold = Object.values(goldHistorySnap.val() || {}).find(g => g.status === 'completed' && g.amount >= REFERRAL_GOLD_MIN);

            if(firstGold){
                await db.ref('refer_cash_requests/'+refReqId).update({
                    status: 'eligible_for_bonus', 
                    referred_user_gold_tx_id: firstGold.id
                });
                await db.ref('users/'+referrerId+'/refer_history/'+refReqId+'/status').set('eligible_for_bonus');
            }
        }

