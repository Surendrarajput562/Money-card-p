        // 3. Prepare Order Data
        const orderId = 'o' + Date.now();
        const subtotalStr = document.getElementById('cart-subtotal')?.innerText || "0";
        const subtotal = Number(subtotalStr.replace(/[^0-9.]/g, ''));

        if (subtotal <= 0) return alert('Your cart is empty');

        const detailedItems = {};
        Object.keys(cart).forEach(cartKey => {
            const item = cart[cartKey];
            const p = productsData[item.productId];
            if (p) {
                detailedItems[cartKey] = {
                    id: item.productId,
                    name: p.name,
                    quantity: item.qty,
                    price: Number(p.price),
                    final_price: (p.price - (p.price * (p.discount || 0) / 100)),
                    image: (p.images && p.images[0]) || '',
                    color: item.color || '—',
                    size: item.size || '—'
                };
            }
        });

        // 4. Save to Firebase (Safety)
        await db.ref('users/' + currentUser.uid + '/address').set(addr);

        const order = {
            id: orderId,
            user: currentUser.uid,
            items: detailedItems,
            total: subtotal,
            address: addr,
            gateway: 'cashfree',
            status: 'pending',
            created_at: Date.now()
        };

        // 5. Call Backend (Vercel)
        const res = await axios.post(CREATE_ORDER_BACKEND_URL, {
            type: 'cart',
            internal_id: orderId,
            txn_amount: subtotal,
            txn_note: `Order ${orderId}`,
            customer_name: (typeof getUserProfileForPayment === 'function') ? getUserProfileForPayment().customer_name : "User",
            customer_mobile: mobile,
            customer_email: currentUser.email || '',
            redirect_url: ALLAPI_REDIRECT_URL,
            user_uid: currentUser.uid,
            order_address: addr,
            order_items: detailedItems
        });

        if (!res.data.success) throw new Error(res.data.message || "Backend Error");

        // 6. Save & Clear Cart
        await db.ref('orders/' + orderId).set(order);
        await db.ref('users/' + currentUser.uid + '/order_history/' + orderId).set(order);

        cart = {};
        if (typeof saveCartToDb === 'function') saveCartToDb();
        if (typeof renderCart === 'function') renderCart();
        if (typeof closeCheckoutModal === 'function') closeCheckoutModal();

        // 7. Launch Cashfree
        if (res.data.results && res.data.results.payment_session_id) {
            const cashfree = Cashfree({ mode: "production" });
            cashfree.checkout({
                paymentSessionId: res.data.results.payment_session_id,
                redirectUrl: ALLAPI_REDIRECT_URL + "?order_id=" + orderId,
            });
        }

    } catch (error) {
        console.error("🔥 CHECKOUT FAILED:", error);
        alert("❌ Error: " + error.message);
    }
