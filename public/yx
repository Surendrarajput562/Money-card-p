        function decrement(cartKey){ 
            if(!cart[cartKey]) return; 
            cart[cartKey].qty = cart[cartKey].qty-1; 
            if(cart[cartKey].qty<=0) delete cart[cartKey]; 
            saveCartToDb(); renderCart(); 
        }
        function removeFromCart(cartKey){ 
            delete cart[cartKey]; 
            saveCartToDb(); renderCart(); 
        }
