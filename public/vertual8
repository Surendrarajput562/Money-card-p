<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MoneyCard | Merchant Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .step-card { display: none; }
        .step-active { display: block; animation: slideUp 0.4s ease; }
        .sidebar { transition: transform 0.3s ease-in-out; }
        .sidebar-open .sidebar { transform: translateX(0); }
        .sidebar-overlay { display: none; }
        .sidebar-open .sidebar-overlay { display: block; }
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .nav-item:hover { background: #f3f4f6; border-left: 4px solid #2563eb; }
        .btn-loading { pointer-events: none; opacity: 0.7; }
        #bankModal { display: none; }
        #bankModal.active { display: flex; }
    </style>
</head>
<body class="bg-gray-50 min-h-screen">

    <div id="bankModal" class="fixed inset-0 bg-black/60 z-[60] items-center justify-center p-6">
        <div class="bg-white w-full max-w-md rounded-3xl p-8 shadow-2xl">
            <h3 class="text-2xl font-black mb-2 italic">Add Bank Account</h3>
            <p class="text-gray-400 text-xs mb-6 uppercase font-bold tracking-widest">Verification Sync V2</p>
            
            <div class="space-y-4">
                <div>
                    <label class="text-[10px] font-bold text-gray-400 ml-2">ACCOUNT NUMBER</label>
                    <input type="text" id="accNum" placeholder="Ex: 8262918036..." class="w-full p-4 bg-gray-50 border rounded-2xl outline-none focus:border-blue-500 font-bold">
                </div>
                <div>
                    <label class="text-[10px] font-bold text-gray-400 ml-2">IFSC CODE</label>
                    <input type="text" id="ifscCode" placeholder="Ex: YESB0000..." class="w-full p-4 bg-gray-50 border rounded-2xl outline-none focus:border-blue-500 font-bold uppercase">
                </div>
                <div>
                    <label class="text-[10px] font-bold text-gray-400 ml-2">PHONE NUMBER (NUMERIC ONLY)</label>
                    <input type="tel" id="accPhone" placeholder="Ex: 9988776655" class="w-full p-4 bg-gray-50 border rounded-2xl outline-none focus:border-blue-500 font-bold">
                </div>
                <button id="btnVerifySync" onclick="processBankSync(this)" class="w-full bg-blue-600 text-white py-4 rounded-2xl font-bold shadow-lg mt-4">Verify & Link</button>
                <button onclick="toggleBankModal(false)" class="w-full text-gray-400 text-sm font-bold py-2">Cancel</button>
            </div>
        </div>
    </div>

    <div class="sidebar-overlay fixed inset-0 bg-black/50 z-40 lg:hidden" onclick="toggleSidebar()"></div>

    <aside id="sidebarNav" class="sidebar fixed top-0 left-0 h-full w-72 bg-white shadow-2xl z-50 -translate-x-full lg:translate-x-0 border-r">
        <div class="p-6 border-b flex justify-between items-center">
            <h1 class="text-2xl font-black text-blue-600 italic">MONEYCARD</h1>
            <button onclick="toggleSidebar()" class="lg:hidden text-gray-500 text-xl"><i class="fas fa-times"></i></button>
        </div>
        <nav class="mt-6">
            <a href="#" class="nav-item flex items-center px-6 py-4 text-blue-600 bg-blue-50 font-bold"><i class="fas fa-home mr-4"></i> Overview</a>
            <a href="javascript:void(0)" onclick="checkLiveBalance(this)" class="nav-item flex items-center px-6 py-4 text-gray-500 font-bold"><i class="fas fa-sync-alt mr-4"></i> Check Balance</a>
            <a href="javascript:void(0)" onclick="toggleBankModal(true)" class="nav-item flex items-center px-6 py-4 text-gray-500 font-bold"><i class="fas fa-university mr-4"></i> Add Bank Account</a>
            <button onclick="logout()" class="w-full flex items-center px-6 py-10 text-red-500 font-bold border-t mt-10"><i class="fas fa-sign-out-alt mr-4"></i> Logout</button>
        </nav>
    </aside>

    <main id="mainContent" class="min-h-screen transition-all duration-300">
        <nav class="p-4 bg-white shadow-sm flex justify-between items-center border-b sticky top-0 z-30">
            <button onclick="toggleSidebar()" class="lg:hidden p-2 text-gray-600"><i class="fas fa-bars text-xl"></i></button>
            <div id="statusTag" class="text-[10px] font-bold bg-blue-50 text-blue-600 px-3 py-1 rounded-full uppercase tracking-widest italic">Syncing...</div>
        </nav>

        <div class="max-w-4xl mx-auto py-8 px-6">
            <div id="kycSection">
                <div id="step-LANDING" class="step-card text-center py-10 step-active">
                    <h2 class="text-4xl font-black text-gray-800 mb-4 tracking-tighter italic">Activate Merchant</h2>
                    <p class="text-gray-500 mb-8 text-sm">Verify your details to start using the dashboard.</p>
                    <button onclick="changeStep('BASICS')" class="w-full bg-blue-600 text-white py-4 rounded-2xl font-bold shadow-xl">Get Started</button>
                </div>
                <div id="step-BASICS" class="step-card bg-white p-6 rounded-3xl shadow-xl border">
                    <h3 class="text-xl font-bold mb-6 text-blue-600 italic">1. Basic Info</h3>
                    <input type="text" id="inName" placeholder="Full Name" class="w-full p-4 bg-gray-50 border rounded-xl mb-4 outline-none">
                    <input type="tel" id="inPhone" placeholder="Mobile Number" class="w-full p-4 bg-gray-50 border rounded-xl mb-6 outline-none">
                    <button onclick="saveBasics(this)" class="w-full bg-black text-white py-4 rounded-xl font-bold">Next Step</button>
                </div>
                <div id="step-PAN" class="step-card bg-white p-6 rounded-3xl shadow-xl border text-center">
                    <h3 class="text-xl font-bold mb-6 italic">2. PAN Verification</h3>
                    <input type="text" id="inPan" placeholder="ABCDE1234F" class="w-full p-5 border-2 border-dashed rounded-xl mb-4 text-center font-black text-2xl uppercase outline-none">
                    <button onclick="verifyPAN(this)" id="btnPan" class="w-full bg-blue-600 text-white py-4 rounded-xl font-bold">Verify Details</button>
                </div>
                <div id="step-DIGILOCKER" class="step-card bg-white p-8 rounded-3xl shadow-xl border text-center">
                    <h3 class="text-2xl font-black mb-2 italic">Aadhaar KYC</h3>
                    <button onclick="openDigi(this)" class="w-full bg-blue-600 text-white py-4 rounded-xl font-bold shadow-lg">Open DigiLocker</button>
                </div>
            </div>

            <div id="dashboardView" class="hidden">
                <div class="bg-gradient-to-br from-gray-900 to-black p-8 rounded-[2.5rem] text-white shadow-2xl relative overflow-hidden mb-8">
                    <p class="text-[10px] font-bold opacity-60 uppercase tracking-widest text-blue-400 italic">Live Bank Balance</p>
                    <div class="mt-4 flex items-baseline gap-2">
                        <span class="text-2xl font-light opacity-50">₮</span>
                        <h2 id="liveBalance" class="text-6xl font-black tracking-tighter">0.00</h2>
                    </div>
                    <div class="mt-8 flex flex-wrap gap-3">
                        <button onclick="checkLiveBalance(this)" class="bg-blue-600 px-6 py-3 rounded-2xl text-[10px] font-bold shadow-lg">CHECK BALANCE</button>
                        <button onclick="toggleBankModal(true)" class="bg-white/10 px-6 py-3 rounded-2xl text-[10px] font-bold border border-white/20">ADD BANK</button>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-white p-6 rounded-3xl shadow-sm border group">
                        <h3 class="text-gray-400 text-[10px] font-black uppercase mb-2">Linked Bank</h3>
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-gray-50 rounded-full flex items-center justify-center text-gray-400"><i class="fas fa-university"></i></div>
                            <div>
                                <p id="dispBank" class="font-black text-gray-800 italic">No Bank Linked</p>
                                <p id="dispAcc" class="text-xs text-gray-400 font-mono tracking-widest">---</p>
                            </div>
                        </div>
                    </div>
                    <div class="bg-white p-6 rounded-3xl shadow-sm border">
                        <h3 class="text-gray-400 text-[10px] font-black uppercase mb-2">Merchant Status</h3>
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-blue-50 rounded-full flex items-center justify-center text-blue-500"><i class="fas fa-user-check"></i></div>
                            <div>
                                <p id="finalName" class="font-black text-blue-600 italic">---</p>
                                <p class="text-[10px] text-green-500 font-bold uppercase">Verified Merchant</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-auth.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-database.js"></script>

    <script>
        const VERCEL_URL = "https://money-card-p.vercel.app";
        const firebaseConfig = { 
            apiKey: "AIzaSyCZ5P2t5xRhy5d0IXV6UWcvbkUWXqyPENA",
            authDomain: "smbrand-4543a.firebaseapp.com",
            databaseURL: "https://smbrand-4543a-default-rtdb.firebaseio.com",
            projectId: "smbrand-4543a",
            appId: "1:720775550032:web:0622548a007597778bad55"
        };
        firebase.initializeApp(firebaseConfig);
        const db = firebase.database();
        let userUID = "";
        let USER_PHONE = "";
        let REGISTERED_NAME = "";
        let IS_BANK_LINKED = false; // Block duplicate link flag

        firebase.auth().onAuthStateChanged(user => {
            if(user) { userUID = user.uid; syncFlow(); }
            else { window.location.href = "kyc"; }
        });

        function syncFlow() {
            db.ref(`users/${userUID}`).on('value', snap => {
                const data = snap.val() || {};
                const profile = data.profile || {};
                const step = profile.step || 'LANDING';
                USER_PHONE = profile.phone || "";
                REGISTERED_NAME = profile.registered_name || "";

                if(step === 'COMPLETED' || step === 'BANK_ADDED') {
                    document.getElementById('kycSection').classList.add('hidden');
                    document.getElementById('dashboardView').classList.remove('hidden');
                    document.getElementById('sidebarNav').classList.remove('hidden');
                    document.getElementById('mainContent').classList.add('lg:ml-72');
                    if(profile.registered_name) document.getElementById('finalName').innerText = profile.registered_name;
                    
                    if(data.bank_details) {
                        IS_BANK_LINKED = true; // Bank mil gaya, ab re-link nahi hone denge
                        document.getElementById('dispBank').innerText = data.bank_details.holder_name;
                        document.getElementById('dispAcc').innerText = "A/C: " + data.bank_details.account_number;
                    }

                    if(data.wallet) {
                        const bal = parseFloat(data.wallet.live_bank_balance || 0);
                        document.getElementById('liveBalance').innerText = bal.toLocaleString('en-IN', {minimumFractionDigits: 2});
                    }
                    document.getElementById('statusTag').innerText = "Merchant Active ✅";
                } else {
                    document.querySelectorAll('.step-card').forEach(c => c.classList.remove('step-active'));
                    const activeStep = document.getElementById('step-' + step);
                    if(activeStep) activeStep.classList.add('step-active');
                }
            });
        }

        function toggleBankModal(show) {
            // Block if already linked
            if(show && IS_BANK_LINKED) {
                alert("Bank is already linked! Re-linking will charge you again.");
                return;
            }

            const modal = document.getElementById('bankModal');
            if(show) {
                modal.classList.add('active');
                document.getElementById('accPhone').value = USER_PHONE.replace(/\D/g, '');
            } else {
                modal.classList.remove('active');
            }
        }

        async function processBankSync(btn) {
            const acc = document.getElementById('accNum').value.trim();
            const ifsc = document.getElementById('ifscCode').value.trim();
            const phoneInput = document.getElementById('accPhone').value.trim();
            
            if(!acc || !ifsc || !phoneInput) return alert("All fields are required");

            setBtnLoading(btn, true, "Verify & Link");
            try {
                const res = await fetch(`${VERCEL_URL}/api/verify-bank-sync`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        userId: userUID,
                        bank_account: acc,
                        ifsc: ifsc,
                        phone: phoneInput,
                        name: REGISTERED_NAME
                    })
                });
                const data = await res.json();
                if(data.success) {
                    alert("Bank Linked: " + data.name);
                    toggleBankModal(false);
                } else {
                    alert("Verification Failed: " + (data.message || "Invalid Data"));
                }
            } catch (e) { alert("API Connection Error"); }
            finally { setBtnLoading(btn, false, "Verify & Link"); }
        }

        async function checkLiveBalance(btn) {
            if(!USER_PHONE) return alert("Phone number not found in profile.");

            setBtnLoading(btn, true, "Redirecting to Bank...");
            try {
                const res = await fetch(`${VERCEL_URL}/api/create-aa-session`, {
                    method: 'POST', 
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ userId: userUID, phone: USER_PHONE })
                });
                const data = await res.json();
                
                if(data.success && data.url) {
                    // Yahan se user Cashfree ke Consent page pe jayega
                    window.location.href = data.url;
                } else {
                    alert("AA Consent Error: " + (data.error?.message || "Check API Settings"));
                }
            } catch (e) { 
                alert("AA Connection Error"); 
            } finally { 
                setBtnLoading(btn, false, "CHECK BALANCE"); 
            }
        }

        // --- Standard Helpers ---
        function setBtnLoading(btn, isLoading, originalText) {
            if(isLoading) { btn.classList.add('btn-loading'); btn.innerHTML = `<i class="fas fa-spinner fa-spin mr-2"></i> Wait...`; }
            else { btn.classList.remove('btn-loading'); btn.innerHTML = originalText; }
        }

        async function saveBasics(btn) {
            const name = document.getElementById('inName').value.trim();
            const phone = document.getElementById('inPhone').value.trim();
            if(!name || phone.length < 10) return alert("Valid info please");
            setBtnLoading(btn, true, "Next Step");
            await db.ref(`users/${userUID}/profile`).update({ name, phone, step: 'PAN' });
            setBtnLoading(btn, false, "Next Step");
        }

        async function verifyPAN(btn) {
            const pan = document.getElementById('inPan').value.trim();
            setBtnLoading(btn, true, "Verify Details");
            try {
                const res = await fetch(`${VERCEL_URL}/api/verify-pan`, {
                    method: 'POST', headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ pan, userId: userUID, name: "User" })
                });
                const data = await res.json();
                if(data.success) await db.ref(`users/${userUID}/profile`).update({ step: 'DIGILOCKER' });
                else alert("PAN Error: " + data.message);
            } catch(e) { alert("PAN API Error"); }
            finally { setBtnLoading(btn, false, "Verify Details"); }
        }

        async function openDigi(btn) {
            const res = await fetch(`${VERCEL_URL}/api/create-digilocker-url`, { 
                method: 'POST', headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ userId: userUID }) 
            });
            const data = await res.json();
            if(data.url) window.location.href = data.url;
        }

        function changeStep(s) { db.ref(`users/${userUID}/profile`).update({ step: s }); }
        function logout() { firebase.auth().signOut(); }
        function toggleSidebar() { document.body.classList.toggle('sidebar-open'); }
    </script>
</body>
</html>
