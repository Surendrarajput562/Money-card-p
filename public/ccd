<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"><title>MoneyCard Access</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-black text-white p-6 font-sans">
    <div class="max-w-md mx-auto bg-zinc-900 rounded-[2rem] p-8 border border-zinc-800 shadow-2xl">
        <h1 class="text-2xl font-bold text-blue-500 text-center mb-6 uppercase tracking-widest">MoneyCard Portal</h1>
        
        <div id="display-area" class="mb-8 p-6 bg-zinc-800/50 rounded-3xl text-center border border-zinc-700/50">
            <p class="text-[10px] text-zinc-500 uppercase mb-1">Live Bank Balance</p>
            <h2 id="balance" class="text-4xl font-black text-zinc-600">₹ --.--</h2>
            <p id="name" class="text-xs mt-3 text-zinc-500 font-bold uppercase">Awaiting Verification</p>
        </div>

        <button onclick="provideAccess()" id="btn" class="w-full bg-blue-600 hover:bg-blue-500 py-5 rounded-2xl font-black text-lg transition-all active:scale-95 shadow-lg shadow-blue-900/20">
            GIVE BANK ACCESS
        </button>
        
        <p id="status" class="text-[10px] text-center mt-6 text-zinc-600 uppercase font-bold tracking-widest">
            Connected to: Vercel Backend
        </p>
    </div>

    <script>
        // BACKEND CONNECTION URL
        const BASE_URL = "https://money-card-p.vercel.app";

        async function provideAccess() {
            const btn = document.getElementById('btn');
            btn.innerText = "CREATING SESSION...";
            btn.disabled = true;
            
            try {
                // Call to Vercel Backend
                const res = await fetch(`${BASE_URL}/api/create-session`, { 
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();

                if (data.success) {
                    // Sandbox Locker Popup
                    window.open(`https://app.sandbox.co.in/locker/${data.sessionId}`, '_blank', 'width=500,height=700');
                    btn.innerText = "ACCESS PENDING...";
                    startPolling(data.sessionId);
                } else {
                    alert("Backend Error: " + data.message);
                    btn.disabled = false;
                }
            } catch (e) { 
                alert("Frontend-Backend Connection Failed!");
                btn.disabled = false;
            }
        }

        function startPolling(id) {
            const poll = setInterval(async () => {
                try {
                    const res = await fetch(`${BASE_URL}/api/get-balance/${id}`);
                    const json = await res.json();

                    if (json.success) {
                        document.getElementById('balance').innerText = "₹ " + json.balance;
                        document.getElementById('name').innerText = json.name; 
                        document.getElementById('balance').className = "text-4xl font-black text-green-400";
                        document.getElementById('status').innerText = "ACCESS GRANTED";
                        document.getElementById('btn').innerText = "VERIFIED";
                        clearInterval(poll);
                    }
                } catch (e) { console.log("Waiting..."); }
            }, 5000);
        }
    </script>
</body>
</html>

