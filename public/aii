<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>MoneyCard Admin - 5x Turbo Engine</title>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <style>
        :root { --bg: #0d1117; --card: #161b22; --text: #c9d1d9; --green: #238636; --red: #da3633; --blue: #58a6ff; }
        body { font-family: 'Segoe UI', sans-serif; background: var(--bg); color: var(--text); padding: 10px; margin: 0; }
        .main-box { max-width: 1200px; margin: 10px auto; background: var(--card); border: 1px solid #30363d; border-radius: 12px; padding: 20px; box-shadow: 0 0 50px rgba(0,0,0,0.8); }
        textarea { width: 100%; background: #010409; border: 1px solid #30363d; color: #7ee787; padding: 15px; border-radius: 8px; margin: 10px 0; font-size: 16px; outline: none; font-family: 'Consolas', monospace; }
        .btn-grid { display: flex; gap: 10px; margin-bottom: 15px; }
        button { flex: 1; padding: 15px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; color: white; text-transform: uppercase; font-size: 13px; transition: 0.1s; }
        button:active { transform: scale(0.98); }
        .btn-ai { background: var(--green); box-shadow: 0 4px #1a6328; }
        .btn-stop { background: var(--red); box-shadow: 0 4px #a12826; }
        .btn-tool { background: #30363d; box-shadow: 0 4px #161b22; }
        #live-terminal { background: #000; border: 2px solid #333; border-radius: 8px; padding: 20px; height: 550px; overflow-y: auto; position: relative; }
        pre { margin: 0; font-family: 'Consolas', monospace; color: #a5d6ff; white-space: pre-wrap; line-height: 1.6; font-size: 14px; letter-spacing: 0.5px; }
        .cursor { display: inline-block; width: 10px; height: 18px; background: var(--blue); animation: blink 0.5s infinite; vertical-align: middle; }
        @keyframes blink { 50% { opacity: 0; } }
        .status-bar { display: flex; justify-content: space-between; font-size: 12px; color: #8b949e; padding: 8px; background: #010409; border-radius: 4px; margin-bottom: 10px; border: 1px solid #333; }
    </style>
</head>
<body>

<div class="main-box">
    <div class="status-bar">
        <span>PROJECT: MONEYCARD (https://money-card-p.vercel.app)</span>
        <span id="stat-info">STATUS: READY | MEMORY: 0</span>
    </div>
    
    <h2 style="color:white; margin:0 0 10px 0;">⚡ 5-ENGINE PARALLEL CONTROL</h2>

    <textarea id="codePrompt" rows="4" placeholder="Bhai, kya likhu? Bol, paancho milkar ek hi file bana dengi turant..."></textarea>
    
    <div class="btn-grid">
        <button class="btn-ai" onclick="runHyperEngine()">🚀 5x Speed Se Likho</button>
        <button class="btn-stop" onclick="stopWriting()">🛑 STOP</button>
        <button class="btn-tool" onclick="copyCode()">Copy Code</button>
        <button class="btn-tool" onclick="resetMemory()">Reset Memory</button>
    </div>

    <div id="live-terminal">
        <pre id="codeOutput"></pre><span id="cursor" class="cursor" style="display:none;"></span>
    </div>
</div>

<script>
    // --- APNI 5 API KEYS YAHAN DALO ---
    const API_KEYS = ["AIzaSyBibyzgaAFIQh2e8By4HXbzZY9uqP_3TV0", "AIzaSyAKfk4SwZqc5cFvX_Y51SXSEWREmQj64Y0", "AIzaSyBYStOh61Tt7u2NWEdWlGOJi4Ojp6KoM0U", "AIzaSyDlxE9d7duMZ_7SUMIQbP9XIUvB4fTIN2k", "AIzaSyAz_MlAxzlWk1DsN9niJnVdnE_sxTLrm9I"];
    let memory = []; 
    let isTyping = false;
    let controllers = [];

    const outputBox = document.getElementById('codeOutput');
    const cursor = document.getElementById('cursor');

    function resetMemory() {
        memory = [];
        outputBox.textContent = "Memory Cleared. Sab bhul gaya!";
        document.getElementById('stat-info').innerText = "STATUS: RESET | MEMORY: 0";
    }

    function stopWriting() {
        isTyping = false;
        controllers.forEach(c => c.abort());
        cursor.style.display = "none";
        document.getElementById('stat-info').innerText = "STATUS: STOPPED";
    }

    async function runHyperEngine() {
        const prompt = document.getElementById('codePrompt').value;
        if(!prompt) return alert("Bhai, prompt to daal!");

        isTyping = true;
        outputBox.textContent = "";
        cursor.style.display = "inline-block";
        document.getElementById('stat-info').innerText = "STATUS: SYNCING 5 ENGINES...";

        // Context Memory add karna taaki purani baatein yaad rakhe
        memory.push({ role: "user", parts: [{ text: prompt }] });
        document.getElementById('stat-info').innerText = `STATUS: WRITING... | MEMORY: ${memory.length}`;

        controllers = API_KEYS.map(() => new AbortController());

        try {
            // Logic: 5 APIs ko ek saath parallel fire karna
            // Ye sab ek hi task par kaam karengi
            const requests = API_KEYS.map((key, i) => 
                axios.post(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${key}`, 
                { contents: memory }, 
                { signal: controllers[i].signal })
            );

            // Promise.any turant result pakad lega bina kisi delay ke
            const response = await Promise.any(requests);
            const fullResponse = response.data.candidates[0].content.parts[0].text;
            
            // Memory mein model ka response save karna
            memory.push({ role: "model", parts: [{ text: fullResponse }] });

            // Super-Sonic Typing Logic (20 chars at a time)
            let charIndex = 0;
            function typeStream() {
                if (charIndex < fullResponse.length && isTyping) {
                    // Ek sath 20 chars phekega taaki speed barood ho jaye
                    outputBox.textContent += fullResponse.substr(charIndex, 20);
                    charIndex += 20;
                    
                    // Zero delay typing
                    setTimeout(typeStream, 0); 
                    
                    // Auto scroll
                    if(charIndex % 60 === 0) outputBox.parentElement.scrollTop = outputBox.parentElement.scrollHeight;
                } else {
                    cursor.style.display = "none";
                    document.getElementById('stat-info').innerText = "STATUS: COMPLETE";
                }
            }
            typeStream();

        } catch (e) {
            if (e.name !== 'AbortError') {
                document.getElementById('stat-info').innerText = "STATUS: ERROR (Check Keys)";
                cursor.style.display = "none";
            }
        }
    }

    function copyCode() {
        navigator.clipboard.writeText(outputBox.innerText);
        alert("Pura Code Copy Ho Gaya!");
    }
</script>
</body>
</html>

