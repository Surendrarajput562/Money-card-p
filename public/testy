async function confirmCheckout() {
    if (!currentUser) return alert('Please login to complete checkout.');

    // 1. Get Address
    const house = document.getElementById('co-addr-house').value.trim();
    const city = document.getElementById('co-addr-city').value.trim();
    const district = document.getElementById('co-addr-district').value.trim();
    const country = document.getElementById('co-addr-country').value.trim();
    if (!house || !city || !district || !country) return alert('Fill all delivery address fields');

    const addr = { house, city, district, country };

    try {
        await db.ref('users/' + currentUser.uid + '/address').set(addr);

        const orderId = 'o' + Date.now();
        const subtotal = Number(document.getElementById('cart-subtotal').innerText) || 0;
        if (subtotal === 0) return alert('cart is empty');

        // 2. Prepare Detailed Items
        const detailedItems = {};
        Object.keys(cart).forEach(cartKey => {
            const cartItem = cart[cartKey];
            const pid = cartItem.productId;
            const p = productsData[pid];
            if (p) {
                detailedItems[cartKey] = {
                    id: pid,
                    name: p.name,
                    quantity: cartItem.qty,
                    price: Number(p.price),
                    final_price: calcDiscountPrice(p.price, p.discount),
                    image: (p.images && p.images[0]) || '',
                    color: cartItem.color || '—',
                    size: cartItem.size || '—'
                };
            }
        });

        const customer = getUserProfileForPayment();

        // 3. Call Backend
        const backendResponse = await axios.post(CREATE_ORDER_BACKEND_URL, {
            type: 'cart',
            internal_id: orderId,
            txn_amount: subtotal,
            txn_note: `Cart Order ${orderId}`,
            customer_name: customer.customer_name,
            customer_mobile: customer.customer_mobile,
            customer_email: customer.customer_email,
            redirect_url: ALLAPI_REDIRECT_URL,
            user_uid: currentUser.uid,
            order_address: addr,
            order_items: detailedItems
        });

        if (!backendResponse.data.success) throw new Error(backendResponse.data.message);

        const paymentData = backendResponse.data.results;

        // 4. Create Order Object (Firebase Safety)
        const order = {
            id: orderId,
            user: currentUser.uid,
            items: detailedItems,
            total: subtotal,
            address: addr,
            gateway: paymentData.payment_gateway,
            txn_id: paymentData.order_id || paymentData.txn_id || '',
            status: 'pending',
            created_at: Date.now()
        };

        // AllAPI ID tabhi jayega jab hoga (Shopping mein nahi jayega)
        if (paymentData.allapi_order_id) {
            order.allapi_order_id = paymentData.allapi_order_id;
        }

        // 5. Save to Firebase
        await db.ref('orders/' + orderId).set(order);
        await db.ref('users/' + currentUser.uid + '/order_history/' + orderId).set(order);

        // 6. Clear UI
        cart = {};
        saveCartToDb();
        renderCart();
        closeCheckoutModal();

        // 7. Payment Execution
        if (paymentData.payment_gateway === 'cashfree') {
            const cashfree = Cashfree({ mode: "production" });
            cashfree.checkout({
                paymentSessionId: paymentData.payment_session_id,
                redirectUrl: ALLAPI_REDIRECT_URL + "?order_id=" + orderId,
            });
        } else if (paymentData.payment_url) {
            window.location.href = paymentData.payment_url;
        }

    } catch (error) {
        console.error("Checkout Failed:", error);
        alert(`❌ Error: ${error.message}`);
    }
}












