<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MoneyCard | Merchant Dashboard Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .tab-content { display: none; }
        .tab-active { display: block; animation: slideUp 0.3s ease; }
        .sidebar { transition: transform 0.3s ease; background: white; }
        .sidebar-open .sidebar { transform: translateX(0); }
        .sidebar-overlay { display: none; }
        .sidebar-open .sidebar-overlay { display: block; }
        @keyframes slideUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .btn-loading { pointer-events: none; opacity: 0.7; }
        .qr-premium-box { background: #ffffff; border: 2px solid #f3f4f6; border-radius: 2.5rem; }
        iframe { width: 100%; height: 600px; border: none; border-radius: 2rem; }

#twoFA_Overlay {
    backdrop-filter: blur(12px);
    background: rgba(255, 255, 255, 0.9);
}
.otp-digit-input {
    letter-spacing: 0.4em;
    text-shadow: 0 0 0 #000;
}
.hidden-2fa { display: none !important; }








 


   </style>
</head>
<body class="bg-gray-50 min-h-screen">

<div id="twoFA_LockScreen" class="fixed inset-0 z-[100] flex items-center justify-center bg-white">
    <div class="w-full max-w-md p-8 text-center">
        <h1 class="text-3xl font-black text-blue-600 italic mb-8">MONEYCARD SECURE</h1>

        <div id="setup-box" class="hidden animate-slideUp">
            <div class="bg-blue-50 p-6 rounded-[2.5rem] mb-6">
                <p class="text-[10px] font-bold text-blue-600 uppercase mb-4 tracking-widest">Scan this QR in Google Authenticator</p>
                <div class="flex justify-center bg-white p-4 rounded-3xl shadow-inner mb-4">
                    <img id="qr2fa_img" src="" class="w-48 h-48">
                </div>
                <p class="text-[10px] font-bold text-gray-400 uppercase mb-2">Manual Secret Key</p>
                <div class="bg-white py-3 px-4 rounded-xl border border-blue-100 flex justify-between items-center">
                    <code id="secret_key_display" class="font-mono font-bold text-blue-600 text-sm">----</code>
                    <button onclick="copySecret()" class="text-blue-600"><i class="fas fa-copy"></i></button>
                </div>
            </div>
            <button onclick="showOtpInput()" class="w-full bg-blue-600 text-white py-5 rounded-[2rem] font-black shadow-lg">I HAVE SAVED IT</button>
        </div>

        <div id="verify-box" class="hidden animate-slideUp">
            <div class="mb-8">
                <i class="fas fa-shield-alt text-5xl text-blue-600 mb-4"></i>
                <h2 class="text-2xl font-black italic">Security Check</h2>
                <p class="text-gray-400 font-bold text-xs uppercase tracking-tighter">Enter 6-digit code from your app</p>
            </div>
            <input type="text" id="2fa_otp" placeholder="000 000" maxlength="6" 
                class="w-full text-center text-4xl font-black tracking-[0.5em] p-6 bg-gray-50 border-none rounded-[2rem] outline-none focus:ring-4 focus:ring-blue-100 mb-6">
            <button id="btn_verify_2fa" onclick="processVerify2FA()" class="w-full bg-black text-white py-5 rounded-[2rem] font-black shadow-xl">UNLOCK DASHBOARD</button>
        </div>
    </div>
</div>






















    <div class="sidebar-overlay fixed inset-0 bg-black/50 z-40 lg:hidden" onclick="toggleSidebar()"></div>
<div id="bankModal" class="fixed inset-0 bg-black/60 z-[60] hidden items-center justify-center p-6">
    <div class="bg-white w-full max-w-md rounded-[2.5rem] p-8 shadow-2xl">
        <h3 class="text-2xl font-black mb-6 italic text-blue-600">Add Bank Account</h3>
        <div class="space-y-4">
            <input type="text" id="bankPhone" placeholder="Mobile Number" class="w-full p-4 bg-gray-50 border rounded-2xl outline-none font-bold">
            
            <input type="text" id="accNum" placeholder="Account Number" class="w-full p-4 bg-gray-50 border rounded-2xl outline-none font-bold">
            <input type="text" id="ifscCode" placeholder="IFSC Code" class="w-full p-4 bg-gray-50 border rounded-2xl outline-none font-bold uppercase">
            
            <button onclick="processBankSync(this)" class="w-full bg-blue-600 text-white py-4 rounded-2xl font-bold shadow-lg mt-2">Verify & Link</button>
            <button onclick="toggleBankModal(false)" class="w-full text-gray-400 font-bold py-2 text-center block">Cancel</button>
        </div>
    </div>
</div>







