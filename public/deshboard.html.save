    <script>
        const VERCEL_URL = "https://money-card-p.vercel.app";
        const firebaseConfig = { 
            apiKey: "AIzaSyCZ5P2t5xRhy5d0IXV6UWcvbkUWXqyPENA",
            authDomain: "smbrand-4543a.firebaseapp.com",
            databaseURL: "https://smbrand-4543a-default-rtdb.firebaseio.com",
            projectId: "smbrand-4543a",
            appId: "1:720775550032:web:0622548a007597778bad55"
        };
        firebase.initializeApp(firebaseConfig);
        const db = firebase.database();
        let userUID = "";
        let selCurr = "USDT";
        let qrCounts = 0;

// --- LOGOUT FUNCTION ---
function logout() {
    if (confirm("Bhai, kya aap sach mein logout karna chahte ho?")) {
        firebase.auth().signOut().then(() => {
            // Session storage saaf karo taaki 2FA wapas maange
            sessionStorage.clear();
            // KYC ya Login page par bhejo
            window.location.href = "kyc"; 
        }).catch((error) => {
            console.error("Logout Error:", error);
            alert("Logout fail ho gaya, dobara try karo.");
        });
    }
}


// --- 2FA SYSTEM CORE LOGIC ---

async function init2FA() {
    if(!userUID) return;

    try {
        const res = await fetch(`${VERCEL_URL}/api/2fa/check`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ userId: userUID })
        });
        const data = await res.json();

        if(data.setup_done) {
            // Agar pehle se set hai to seedha OTP maango
            document.getElementById('verify-box').classList.remove('hidden');
        } else {
            // Naya user hai to QR aur Secret dikhao
            document.getElementById('qr2fa_img').src = data.qr_code;
            document.getElementById('secret_key_display').innerText = data.secret;
            document.getElementById('setup-box').classList.remove('hidden');
        }
    } catch (e) {
        console.error("2FA Load Error", e);
    }
}

function refreshIframe(iframeId) {
    const iframe = document.getElementById(iframeId);
    if (iframe) {
        const url = new URL(iframe.src);
        // URL ke peeche ek naya timestamp (t=12345) add kar rahe hain taaki cache bypass ho jaye
        url.searchParams.set('t', Date.now()); 
        iframe.src = url.toString();
        console.log("Iframe Refreshed with latest version!");
    }
}


function showOtpInput() {
    document.getElementById('setup-box').classList.add('hidden');
    document.getElementById('verify-box').classList.remove('hidden');
}

async function processVerify2FA() {
    const otp = document.getElementById('2fa_otp').value.trim();
    const btn = document.getElementById('btn_verify_2fa');

    if(otp.length !== 6) return alert("Bhai, 6 digit code daal!");

    btn.innerText = "VERIFYING...";
    btn.disabled = true;

    try {
        const res = await fetch(`${VERCEL_URL}/api/2fa/verify`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ userId: userUID, token: otp })
        });
        const result = await res.json();

        if(result.success) {
            // Lock Screen Hatao
            document.getElementById('twoFA_LockScreen').classList.add('hidden');
            // Dashboard sync start karo
            syncData();
        } else {
            alert("Invalid OTP! Try again.");
            btn.innerText = "UNLOCK DASHBOARD";
            btn.disabled = false;
        }
    } catch (e) {
        alert("Verification Server Error");
        btn.disabled = false;
    }
}

function copySecret() {
    const key = document.getElementById('secret_key_display').innerText;
    navigator.clipboard.writeText(key);
    alert("Secret Key Copied!");
}

// 🔥 Integration: Firebase Auth State me call karo
firebase.auth().onAuthStateChanged(user => {
    if(user) { 
        userUID = user.uid; 
        init2FA(); // <-- Sabse pehle 2FA check hoga
    } else { 
        window.location.href = "kyc"; 
    }
});


















function syncData() {
        db.ref(`users/${userUID}`).on('value', snap => {
            const data = snap.val();
            if(!data) return;
            
            qrCounts = data.qr_generation_count || 0;
            document.getElementById('qrLimitInfo').innerText = `Limit Used: ${qrCounts} / 3`;

            if(data.profile) {
                document.getElementById('finalName').innerText = data.profile.registered_name || data.profile.name || "Merchant";
            }
            if(data.bank_details) {
                document.getElementById('dispBank').innerText = data.bank_details.bank_name;
                document.getElementById('dispAcc').innerText = "A/C: " + data.bank_details.account_number;
            }
            if(data.wallet) {
                document.getElementById('liveBalance').innerText = parseFloat(data.wallet.live_bank_balance || 0).toLocaleString('en-IN', {minimumFractionDigits: 2});
            }
            
            if(data.qrs && data.qrs[selCurr]) {
                updateQRDisplay(data.qrs[selCurr].qr_url, data.qrs[selCurr].method);
            }
        });
    }

    // --- 1. DISPLAY LOGIC (FIXED) ---
    function updateQRDisplay(link, method) {
        const img = document.getElementById('qrImg'); // Match with HTML ID
        const txt = document.getElementById('qrAddr'); // Match with HTML ID
        const container = document.getElementById('qrResult');
        const head = document.getElementById('qrLabelHead');

        if(!img || !txt || !container) return;

        img.src = `https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=${encodeURIComponent(link)}`;
        txt.innerText = link;
        if(head) head.innerText = `${selCurr} - ${method.toUpperCase()} LIVE`;
        
        container.classList.remove('hidden');
        container.style.display = 'block';
    }


async function processBankSync(btn) {
    const phone = document.getElementById('bankPhone').value.trim();
    const acc = document.getElementById('accNum').value.trim();
    const ifsc = document.getElementById('ifscCode').value.trim();
    const name = document.getElementById('finalName').innerText || "Merchant";

    if(!phone || !acc || !ifsc) return alert("Bhai, saari details bharna zaroori hai!");

    btn.classList.add('btn-loading');
    btn.innerText = "Verifying...";

    try {
        const res = await fetch(`${VERCEL_URL}/api/verify-bank-sync`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                userId: userUID,
                bank_account: acc,
                ifsc: ifsc,
                phone: phone, // Ab asli mobile number jayega
                name: name
            })
        });
        
        const d = await res.json();
        
        if(d.success) {
            alert("Bank Verified: " + d.name);
            toggleBankModal(false);
            // Refresh logic ya Firebase sync automatically UI update kar dega
        } else {
            alert(d.message || "Verification fail ho gayi!");
        }
    } catch(e) {
        alert("Server Error! Check backend connection.");
    } finally {
        btn.classList.remove('btn-loading');
        btn.innerText = "Verify & Link";
    }
}





























        }

 










x
            });
            btn.classList.replace('border-gray-100', 'border-blue-600');
            btn.classList.add('bg-blue-50', 'text-blue-600');
            
            const net = document.getElementById('networkSelect');
            net.innerHTML = "";
            let opts = [];
            if(c === 'SATS') opts = [{v: 'lightning', t: 'Lightning Network'}, {v: 'bitcoin', t: 'Bitcoin On-Chain'}];
            else if(c === 'USDT') opts = [{v: 'tron', t: 'TRC20'}, {v: 'ethereum', t: 'ERC20'}, {v: 'solana', t: 'Solana (SPL)'}, {v: 'ton', t: 'TON'}];
            else opts = [{v: 'ethereum', t: 'ERC20'}, {v: 'solana', t: 'Solana'}, {v: 'ton', t: 'TON'}];
            
            opts.forEach(o => {
                const el = document.createElement('option');
                el.value = o.v; el.innerText = o.t;
                net.appendChild(el);
            });

            // Re-fetch stored QR for this asset if it exists
            db.ref(`users/${userUID}/qrs/${selCurr}`).once('value', s => {
                if(s.exists()) updateQRDisplay(s.val().qr_url, s.val().method);
                else document.getElementById('qrResult').classList.add('hidden');
            });
        }


async function generateGlobalQR(btn) {
    const net = document.getElementById('networkSelect').value;
    btn.classList.add('btn-loading');
    btn.innerText = "Processing...";

    try {
        const res = await fetch(`${VERCEL_URL}/api/create-global-qr`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ 
                userId: userUID, 
                selected_currency: selCurr, 
                networks: [net] 
            })
        });
        
        const responseData = await res.json();
        // Speed API ka asli maal 'data' ke andar hai
        const speedData = responseData.data; 

        console.log("Speed Response:", speedData);

        if(responseData.success && speedData) {
            // Seedha 'payment_request' uthaya (Lightning ke liye yahi hai)
            const finalAddr = speedData.payment_request || speedData.address || speedData.url;

            if(!finalAddr) return alert("No Link Found!");

            // Firebase me poora object save
            await db.ref(`users/${userUID}/qrs/${selCurr}`).set({
                qr_url: finalAddr,
                id: speedData.id,
                method: speedData.method,
                timestamp: Date.now()
            });

            // Display QR
            updateQRDisplay(finalAddr, speedData.method);
            alert("QR Activated!");
        }
    } catch(e) { 
        console.error("Critical Error:", e);
    } finally { 
        btn.classList.remove('btn-loading'); 
        btn.innerText = "ACTIVATE GLOBAL ONE QR"; 
    }
}

function updateQRDisplay(link, method) {
    const img = document.getElementById('qrImage');
    const txt = document.getElementById('qrAddressText');
    const container = document.getElementById('qrResult');

    // QR generate using Google Charts API or QRserver
    img.src = `https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=${encodeURIComponent(link)}`;
    txt.innerText = link;
    
    container.classList.remove('hidden');
    container.style.display = 'block';
}























// --- Bank Modal Toggle ---
function toggleBankModal(s) { 
    document.getElementById('bankModal').style.display = s ? 'flex' : 'none'; 
}

// --- Tab System ---
function showTab(id) {
    document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('tab-active'));
    document.getElementById('tab-' + id.replace('.html', '')).classList.add('tab-active');
}

// --- Sidebar Toggle ---
function toggleSidebar() { 
    document.body.classList.toggle('sidebar-open'); 
}













    </script>
</body>
</html>







