                                <button onclick="selectCurr('USDT', this)" class="curr-btn flex-1 p-4 border-2 rounded-2xl font-bold border-blue-600 bg-blue-50 text-blue-600">USDT</button>
                                <button onclick="selectCurr('SATS', this)" class="curr-btn flex-1 p-4 border-2 rounded-2xl font-bold border-gray-100">BTC</button>
                                <button onclick="selectCurr('USDC', this)" class="curr-btn flex-1 p-4 border-2 rounded-2xl font-bold border-gray-100">USDC</button>
