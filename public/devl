            // Default to dashboard or last active section
            const lastActiveSection = localStorage.getItem('lastActiveSection') || 'dashboard-section';
            const lastActiveType = localStorage.getItem('lastActiveType') || 'section';
            if (lastActiveType === 'iframe') {
                const url = localStorage.getItem('lastActiveUrl');
