        const apiKey = dom.apiKeyFields[0].value;
        const secretKey = dom.secretKeyFields[0].value;

        if (apiKey === 'NOT_GENERATED' || !secretKey) {
            resBox.innerText = JSON.stringify({ success: false, message: "API Key or Secret Key not available. Please ensure you are logged in and keys are generated." }, null, 2);
            return;
        }

        let requestBody = {};
        if (bodyKeysJson) {
            try {
                const bodyMap = JSON.parse(bodyKeysJson);
                for (const key in bodyMap) {
                    const inputId = bodyMap[key];
                    const inputElement = document.getElementById(inputId);
                    if (inputElement) {
                         // Special handling for date inputs to ensure correct format or other dynamic values
                        if (inputElement.type === 'date' && inputElement.value) {
                            requestBody[key] = inputElement.value; // YYYY-MM-DD
                        } else if (inputElement.tagName === 'SELECT' || inputElement.type === 'text') {
                            if (inputElement.value) { // Only include if value exists
                                requestBody[key] = inputElement.value;
                            } else if (key === 'verification_id' && path === 'verify-employment') {
                                // Auto-generate verification_id if empty for employment API
                                requestBody[key] = `emp_${Date.now()}`;
                            }
                        }
                    } else {
                        console.warn(`Input element with ID ${inputId} not found for key ${key}.`);
                    }
                }
            } catch (e) {
                console.error("Error parsing body keys JSON:", e);
                resBox.innerText = JSON.stringify({ success: false, message: "Configuration error: Invalid body keys." }, null, 2);
                return;
            }
        }
        
        let apiUrl = `${VERCEL_API}/${path}`;

        // Handle path parameters for GET requests (e.g., /vehicle-rc/:regNo)
        if (method === 'GET' && pathParamKey && requestBody[pathParamKey]) {
            const paramValue = encodeURIComponent(requestBody[pathParamKey]);
            apiUrl = `${VERCEL_API}/${path}/${paramValue}`;
            delete requestBody[pathParamKey]; // Remove from body as it's in path
        } else if (method === 'GET' && Object.keys(requestBody).length > 0) {
            // Append query parameters for other GET requests if needed
            const queryParams = new URLSearchParams(requestBody).toString();
            if (queryParams) {
                apiUrl += `?${queryParams}`;
            }
        }

        try {
            const requestOptions = {
                method: method,
                headers: { 
                    'x-api-key': apiKey,
                    'x-user-id': secretKey // Assuming secret_key is user_uid
                }
            };

            if (method !== 'GET') {
