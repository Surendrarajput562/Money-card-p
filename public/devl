                return;
            }

            const response = await fetch(apiUrl, requestOptions);
            const result = await response.json();
            resBox.innerText = JSON.stringify(result, null, 2);

            // Update balance after an API call (if backend returns `remaining` or force refresh from Firebase)
            if (result.remaining !== undefined) {
                 dom.balanceVal.innerText = "₹ " + result.remaining.toFixed(2);
            } else {
                // If the API doesn't return balance, force a refresh from Firebase
                auth.currentUser && db.ref(`users/${auth.currentUser.uid}/api_settings/balance`).once('value', snapshot => {
                    const balance = snapshot.val()?.balance || 0;
                    dom.balanceVal.innerText = "₹ " + balance.toFixed(2);
