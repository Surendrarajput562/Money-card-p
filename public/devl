<div id="main-container">
    <div class="top-nav">
        <div class="top-nav-title">
            Developer Portal <span class="top-nav-status-badge">LIVE</span>
        </div>
        <div class="top-nav-user-info">
            <i class="far fa-bell"></i>
            <div id="userEmail" class="user-email-display">Loading...</div>
        </div>
    </div>

    <iframe id="iframe-container" title="Developer Analytics"></iframe>

    <div class="content-area" id="main-content-scroll">
        
        <div id="dashboard-section" class="api-page">
            <h2>Welcome to MoneyCard Developer Suite</h2>
            <p>Your hub for powerful financial APIs. Integrate seamlessly and build the future of finance.</p>
            <div class="wallet-row">
                <div class="white-card">
                    <div class="balance-title">Secure ID Wallet Balance</div>
                    <div class="balance-amt" id="balanceVal">₹ 0.00</div>
                    <button>Recharge</button>
                </div>
                <div class="white-card">
                    <div class="balance-title">Merchant Details</div>
                    <div class="merchant-details">
                        <strong>ID:</strong> <span id="m_id">...</span><br>
                        <strong>Status:</strong> <span class="status-active">● Active</span>
                    </div>
                </div>
            </div>
        </div>

        <div id="pan-section" class="api-page">
            <div class="api-form-box">
                <h3>PAN Verification (Lite)</h3>
                <div class="endpoint-badge">POST https://money-card-p.vercel.app/api/v1/verify-pan</div>
                
                <div class="api-input-group">
                    <div><label>API KEY</label><input type="text" class="api-key-fld readonly-input" readonly></div>
                    <div><label>SECRET KEY</label><input type="text" class="secret-fld readonly-input" readonly></div>
                </div>

                <label for="panInput">Enter PAN Number</label>
                <input type="text" id="panInput" placeholder="Ex: ABCDE1234F" maxlength="10">
                <button data-api-path="verify-pan" data-cost="1.00" data-result-id="panRes"
                        data-body-keys='{"pan": "panInput"}'>Verify Now (₹1.00)</button>
                <pre id="panRes">// Response will appear here...</pre>
            </div>
        </div>

        <div id="aadhaar-section" class="api-page">
            <div class="api-form-box">
                <h3>Aadhaar Masking (Dummy)</h3>
                <div class="endpoint-badge">POST https://money-card-p.vercel.app/api/v1/aadhaar-mask</div>
                
                <div class="api-input-group">
                    <div><label>API KEY</label><input type="text" class="api-key-fld readonly-input" readonly></div>
                    <div><label>SECRET KEY</label><input type="text" class="secret-fld readonly-input" readonly></div>
                </div>

                <label for="aadhaarInput">Aadhaar Number (Last 4 Digits Only)</label>
                <input type="text" id="aadhaarInput" placeholder="Ex: 1234" maxlength="4">
                <button data-api-path="aadhaar-mask" data-cost="0.50" data-result-id="aadhaarRes"
                        data-body-keys='{"aadhaar_last_4": "aadhaarInput"}'>Mask Aadhaar (₹0.50)</button>
                <pre id="aadhaarRes">// Dummy Response: {"success": true, "masked_aadhaar": "XXXXXXXX1234", "message": "This is a dummy API response."}</pre>
            </div>
        </div>

        <div id="voterid-verify-section" class="api-page">
            <div class="api-form-box">
                <h3>Voter ID Verification</h3>
                <div class="endpoint-badge">POST https://money-card-p.vercel.app/api/v1/verify-voterid</div>
                
                <div class="api-input-group">
                    <div><label>API KEY</label><input type="text" class="api-key-fld readonly-input" readonly></div>
                    <div><label>SECRET KEY</label><input type="text" class="secret-fld readonly-input" readonly></div>
                </div>

                <label for="voteridEpic">EPIC Number</label>
                <input type="text" id="voteridEpic" placeholder="Ex: ABC1234567">
                <label for="voteridName">Name</label>
                <input type="text" id="voteridName" placeholder="Ex: John Doe">
                <button data-api-path="verify-voterid" data-cost="2.00" data-result-id="voteridRes"
                        data-body-keys='{"epic_number": "voteridEpic", "name": "voteridName"}'>Verify Voter ID (₹2.00)</button>
                <pre id="voteridRes">// Response will appear here...</pre>
            </div>
        </div>

        <div id="passport-verify-section" class="api-page">
            <div class="api-form-box">
                <h3>Passport Verification</h3>
                <div class="endpoint-badge">POST https://money-card-p.vercel.app/api/v1/verify-passport</div>
                
                <div class="api-input-group">
                    <div><label>API KEY</label><input type="text" class="api-key-fld readonly-input" readonly></div>
                    <div><label>SECRET KEY</label><input type="text" class="secret-fld readonly-input" readonly></div>
                </div>

                <label for="passportNumber">Passport Number</label>
                <input type="text" id="passportNumber" placeholder="Ex: M1234567">
                <label for="passportDOB">Date of Birth (YYYY-MM-DD)</label>
                <input type="date" id="passportDOB">
                <label for="passportSurname">Surname</label>
                <input type="text" id="passportSurname" placeholder="Ex: Doe">
                <label for="passportGivenName">Given Name</label>
                <input type="text" id="passportGivenName" placeholder="Ex: John">

                <button data-api-path="verify-passport" data-cost="6.00" data-result-id="passportRes"
                        data-body-keys='{"passport_number": "passportNumber", "dob": "passportDOB", "surname": "passportSurname", "given_name": "passportGivenName"}'>Verify Passport (₹6.00)</button>
                <pre id="passportRes">// Response will appear here...</pre>
            </div>
        </div>

        <div id="dl-verify-section" class="api-page">
            <div class="api-form-box">
                <h3>Driving License Verification</h3>
                <div class="endpoint-badge">POST https://money-card-p.vercel.app/api/v1/verify-dl</div>
                
                <div class="api-input-group">
                    <div><label>API KEY</label><input type="text" class="api-key-fld readonly-input" readonly></div>
                    <div><label>SECRET KEY</label><input type="text" class="secret-fld readonly-input" readonly></div>
                </div>

                <label for="dlNumber">Driving License Number</label>
                <input type="text" id="dlNumber" placeholder="Ex: DL0120150123456">
                <label for="dlDOB">Date of Birth (YYYY-MM-DD)</label>
                <input type="date" id="dlDOB">

                <button data-api-path="verify-dl" data-cost="3.00" data-result-id="dlRes"
                        data-body-keys='{"dl_number": "dlNumber", "dob": "dlDOB"}'>Verify Driving License (₹3.00)</button>
                <pre id="dlRes">// Response will appear here...</pre>
            </div>
        </div>

        <div id="argos-verify-section" class="api-page">
            <div class="api-form-box">
                <h3>Advanced ID Verification (Argos)</h3>
                <div class="endpoint-badge">POST https://money-card-p.vercel.app/api/v1/argos-verify</div>
                
                <div class="api-input-group">
                    <div><label>API KEY</label><input type="text" class="api-key-fld readonly-input" readonly></div>
                    <div><label>SECRET KEY</label><input type="text" class="secret-fld readonly-input" readonly></div>
                </div>

                <label for="argosIDNumber">ID Number</label>
                <input type="text" id="argosIDNumber" placeholder="Ex: A1234567B">
                <label for="argosIDType">ID Type</label>
                <select id="argosIDType">
                    <option value="PASSPORT">Passport</option>
                    <option value="NATIONAL_ID">National ID</option>
                    <option value="DRIVING_LICENSE">Driving License</option>
                </select>
                <label for="argosCountry">Issuing Country (ISO 3166-1 alpha-3)</label>
                <input type="text" id="argosCountry" placeholder="Ex: IND">
                <label for="argosName">Name on ID</label>
                <input type="text" id="argosName" placeholder="Ex: John Doe">

                <button data-api-path="argos-verify" data-cost="5.00" data-result-id="argosRes"
                        data-body-keys='{"idNumber": "argosIDNumber", "idType": "argosIDType", "country": "argosCountry", "name": "argosName"}'>Verify with Argos (₹5.00)</button>
                <pre id="argosRes">// Response will appear here...</pre>
            </div>
        </div>

        <div id="face-liveness-section" class="api-page">
            <div class="api-form-box">
                <h3>Face Liveness Check</h3>
                <div class="endpoint-badge">POST https://money-card-p.vercel.app/api/v1/face-liveness</div>
                <p style="font-size: 13px; color: var(--text-label);">Note: This API typically expects multipart/form-data with an image file. For this demo, please enter a dummy image URL, assuming the backend can process it. A real implementation would use a file input and FormData.</p>
                
                <div class="api-input-group">
                    <div><label>API KEY</label><input type="text" class="api-key-fld readonly-input" readonly></div>
                    <div><label>SECRET KEY</label><input type="text" class="secret-fld readonly-input" readonly></div>
                </div>

                <label for="faceLivenessImage">Image URL (for demo purposes)</label>
                <input type="text" id="faceLivenessImage" placeholder="Ex: https://example.com/selfie.jpg">
                
                <button data-api-path="face-liveness" data-cost="5.00" data-result-id="faceLivenessRes"
                        data-body-keys='{"image_url": "faceLivenessImage"}'>Check Liveness (₹5.00)</button>
                <pre id="faceLivenessRes">// Response will appear here...</pre>
            </div>
        </div>

        <div id="bank-verify-section" class="api-page">
            <div class="api-form-box">
                <h3>Bank Account Name Match</h3>
                <div class="endpoint-badge">POST https://money-card-p.vercel.app/api/v1/bank-sync</div>
                
                <div class="api-input-group">
                    <div><label>API KEY</label><input type="text" class="api-key-fld readonly-input" readonly></div>
                    <div><label>SECRET KEY</label><input type="text" class="secret-fld readonly-input" readonly></div>
                </div>

                <label for="accNum">Account Number</label>
                <input type="text" id="accNum" placeholder="000000000000">
                <label for="ifscCode">IFSC Code</label>
                <input type="text" id="ifscCode" placeholder="IFSC0000000">
                
                <button data-api-path="bank-sync" data-cost="2.00" data-result-id="bankRes"
                        data-body-keys='{"bank_account": "accNum", "ifsc": "ifscCode"}'>Fetch Name (₹2.00)</button>
                <pre id="bankRes">// Bank response data...</pre>
            </div>
        </div>

        <div id="add-bank-account-section" class="api-page">
            <div class="api-form-box">
                <h3>Add Bank Account (Beneficiary)</h3>
                <div class="endpoint-badge">POST https://money-card-p.vercel.app/api/v1/bank-sync</div>
                <p style="font-size: 13px; color: var(--text-label);">Note: This is a demo endpoint. In a real scenario, this would likely be a separate API for adding a beneficiary account, not just verifying its existence.</p>
                
                <div class="api-input-group">
                    <div><label>API KEY</label><input type="text" class="api-key-fld readonly-input" readonly></div>
                    <div><label>SECRET KEY</label><input type="text" class="secret-fld readonly-input" readonly></div>
                </div>

                <label for="addAccNum">Account Number</label>
                <input type="text" id="addAccNum" placeholder="000000000000">
                <label for="addIfscCode">IFSC Code</label>
                <input type="text" id="addIfscCode" placeholder="IFSC0000000">
                <label for="addAccountHolderName">Account Holder Name</label>
                <input type="text" id="addAccountHolderName" placeholder="Ex: John Doe">
                <label for="addPhoneNumber">Phone Number</label>
                <input type="text" id="addPhoneNumber" placeholder="Ex: 9999999999">
                
