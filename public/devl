        const resId = buttonElement.dataset.resultId;
        const method = buttonElement.dataset.method || 'POST'; // Default to POST
        const bodyKeysJson = buttonElement.dataset.bodyKeys;
        const pathParamKey = buttonElement.dataset.pathParamKey;

        const resBox = document.getElementById(resId);
        if (!resBox) {
            console.error(`Result box with ID ${resId} not found.`);
            return;
        }
        resBox.innerText = "Processing...";
        
