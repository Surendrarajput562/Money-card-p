            }

        } catch (e) {
            console.error("API Call Error:", e);
            resBox.innerText = JSON.stringify({ success: false, message: e.message || "Error calling endpoint!" }, null, 2);
        }
    }

    // Event Delegation for API Buttons
    dom.mainContentScroll.addEventListener('click', (event) => {
        const button = event.target.closest('button[data-api-path]');
