<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MoneyCard Developer Portal | 500+ Financial APIs</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        :root { --gold: #ffd700; --dark: #0a0a0a; --gray: #161616; --text: #e0e0e0; }
        body { margin: 0; font-family: 'Plus Jakarta Sans', sans-serif; background: var(--dark); color: var(--text); scroll-behavior: smooth; }
        
        /* Navigation */
        nav { display: flex; justify-content: space-between; align-items: center; padding: 15px 6%; background: rgba(10,10,10,0.8); backdrop-filter: blur(15px); position: sticky; top: 0; z-index: 1000; border-bottom: 1px solid #222; }
        .logo { font-size: 22px; font-weight: 800; color: var(--gold); text-decoration: none; letter-spacing: -1px; }
        .nav-links a { color: #fff; text-decoration: none; margin-left: 25px; font-size: 14px; font-weight: 600; transition: 0.3s; }
        .nav-links a:hover { color: var(--gold); }
        .btn-login { background: var(--gold); color: #000; padding: 8px 20px; border-radius: 6px; font-weight: 700; border: none; cursor: pointer; margin-left: 20px; }

        /* Hero Section */
        .hero { padding: 120px 6% 80px; text-align: center; background: radial-gradient(circle at center, #1a1a00 0%, #0a0a0a 100%); }
        .hero h1 { font-size: 60px; font-weight: 800; line-height: 1.1; margin-bottom: 20px; }
        .hero h1 span { color: var(--gold); }
        .hero p { font-size: 18px; color: #888; max-width: 700px; margin: 0 auto 30px; }

        /* API Grid */
        .section-title { text-align: center; margin-bottom: 50px; }
        .section-title h2 { font-size: 36px; color: #fff; }
        .api-container { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; padding: 0 6% 80px; }
        .api-card { background: var(--gray); border: 1px solid #222; padding: 25px; border-radius: 15px; transition: 0.3s; }
        .api-card:hover { border-color: var(--gold); transform: translateY(-5px); }
        .api-card h3 { color: var(--gold); font-size: 18px; margin-bottom: 10px; }
        .api-card p { font-size: 13px; color: #aaa; line-height: 1.6; margin: 0; }
        .api-tag { font-size: 10px; font-weight: 800; background: #333; color: var(--gold); padding: 3px 8px; border-radius: 4px; margin-bottom: 10px; display: inline-block; }

        /* Auth Modal Overlay */
        #auth-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.9); z-index: 10000; align-items: center; justify-content: center; backdrop-filter: blur(5px); }
        .auth-container { background: #1c1c1c; border: 1px solid var(--gold); border-radius: 20px; padding: 40px; width: 90%; max-width: 400px; box-shadow: 0 0 50px rgba(255,215,0,0.1); }
        .auth-container h2 { text-align: center; color: var(--gold); margin-bottom: 25px; }
        .auth-container input { width: 100%; padding: 14px; margin: 10px 0; border-radius: 10px; border: 1px solid #333; background: #000; color: #fff; box-sizing: border-box; }
        .auth-container button { width: 100%; padding: 14px; margin: 20px 0 10px; border: none; border-radius: 10px; background: var(--gold); font-weight: 800; cursor: pointer; font-size: 16px; }
        .forgot-link { display: block; text-align: right; color: #888; font-size: 12px; cursor: pointer; text-decoration: underline; }
        .switch { text-align: center; margin-top: 15px; font-size: 14px; }
        .switch span { color: var(--gold); cursor: pointer; font-weight: bold; text-decoration: underline; }

        /* Footer */
        footer { padding: 60px 6%; background: #050505; border-top: 1px solid #222; text-align: center; }
        .contact-info { margin-top: 20px; color: var(--gold); font-weight: 600; }
    </style>
</head>
<body>

<nav>
    <a href="#" class="logo">MONEYCARD.SPACE</a>
    <div class="nav-links">
        <a href="#">Home</a>
        <a href="#">Secure ID</a>
        <a href="#">Developers</a>
        <a href="#">Docs</a>
        <button class="btn-login" onclick="openAuth()">Login / Signup</button>
    </div>
</nav>

<section class="hero">
    <div class="api-tag">DEVELOPER HUB</div>
    <h1>Powerful <span>500+ Financial APIs</span> for Next-Gen Apps</h1>
    <p>Onboard users instantly with PAN, Aadhaar, Video KYC, and Bank Verification. Scalable, Secure, and Built for Developers.</p>
    <div style="display: flex; gap: 15px; justify-content: center;">
        <button class="btn-login" style="padding: 15px 40px;" onclick="openAuth()">Get Started Now</button>
        <button style="background: transparent; border: 1px solid #444; color: #fff; padding: 15px 40px; border-radius: 6px; cursor: pointer;">View Docs</button>
    </div>
</section>

<div class="section-title">
    <h2>Our Core Services</h2>
    <p style="color: #666;">Everything you need to build a fintech product.</p>
</div>

<div class="api-container">
    <div class="api-card">
        <div class="api-tag">IDENTITY</div>
        <h3>PAN & Aadhaar 360</h3>
        <p>Instant verification, OCR, Aadhaar Masking, and DigiLocker integration for seamless onboarding.</p>
    </div>
    <div class="api-card">
        <div class="api-tag">BANKING</div>
        <h3>Penny Drop Verification</h3>
        <p>Verify any bank account instantly by depositing ₹1. Includes Reverse Penny Drop & IFSC Search.</p>
    </div>
    <div class="api-card">
        <div class="api-tag">KYC</div>
        <h3>Video KYC (V-KYC)</h3>
        <p>RBI compliant video-based customer identification with AI-powered face liveness check.</p>
    </div>
    <div class="api-card">
        <div class="api-tag">CRYPTO</div>
        <h3>Crypto-Fiat Exchange</h3>
        <p>Integrated Tether (USDT) like solutions and fiat-to-crypto rails for global payments.</p>
    </div>
    <div class="api-card">
        <div class="api-tag">LENDING</div>
        <h3>Credit Report (CIBIL)</h3>
        <p>Fetch real-time credit scores and detailed bureau reports from CIBIL & Experian.</p>
    </div>
    <div class="api-card">
        <div class="api-tag">BUSINESS</div>
        <h3>MCA & GST KYB</h3>
        <p>Verify companies (CIN), Directors (DIN), and GST filings directly from Govt databases.</p>
    </div>
    <div class="api-card">
        <div class="api-tag">UTILITY</div>
        <h3>Telecom & Electricity</h3>
        <p>Get mobile owner details, bill history, and fraud checks on email/phone.</p>
    </div>
    <div class="api-card">
        <div class="api-tag">COMPLIANCE</div>
        <h3>eSign & eStamp</h3>
        <p>Digital document signing and legal stamp generation integrated into your workflow.</p>
    </div>
    <div class="api-card">
        <div class="api-tag">EMPLOYMENT</div>
        <h3>EPFO & ESIC</h3>
        <p>Check employment history, UAN verification, and salary slips via EPFO Passbook API.</p>
    </div>
</div>

<footer>
    <div class="logo">MONEYCARD</div>
    <p style="margin-top: 15px; color: #555; font-size: 14px;">© 2026 MoneyCard Financial Technologies. All Rights Reserved.</p>
    <div class="contact-info">Support: moneycard@zohomail.in</div>
</footer>


<section id="contact" style="padding: 80px 6%; background: #0d0d0d;">
    <div class="section-title">
        <h2>Contact Our API Experts</h2>
        <p>Need a custom "Pay as you go" plan or a specific Payment Gateway? Let's talk.</p>
    </div>
    <div style="max-width: 600px; margin: 0 auto; background: var(--gray); padding: 40px; border-radius: 20px; border: 1px solid #333;">
        <form id="contactForm">
            <input type="text" id="c-name" placeholder="Full Name" required style="width: 100%; padding: 14px; margin: 10px 0; border-radius: 10px; border: 1px solid #333; background: #000; color: #fff; box-sizing: border-box;">
            <input type="email" id="c-email" placeholder="Email Address" required style="width: 100%; padding: 14px; margin: 10px 0; border-radius: 10px; border: 1px solid #333; background: #000; color: #fff; box-sizing: border-box;">
            <input type="text" id="c-mobile" placeholder="Mobile Number" required style="width: 100%; padding: 14px; margin: 10px 0; border-radius: 10px; border: 1px solid #333; background: #000; color: #fff; box-sizing: border-box;">
            <select id="c-need" style="width: 100%; padding: 14px; margin: 10px 0; border-radius: 10px; border: 1px solid #333; background: #000; color: #fff; box-sizing: border-box;">
                <option value="Payment Gateway">Need Payment Gateway</option>
                <option value="Custom API">Need Custom API</option>
                <option value="Pay as you go">Pay As You Go Plan</option>
            </select>
            <textarea id="c-message" placeholder="Your Message" required style="width: 100%; padding: 14px; margin: 10px 0; border-radius: 10px; border: 1px solid #333; background: #000; color: #fff; box-sizing: border-box; height: 100px;"></textarea>
            <button type="submit" style="width: 100%; padding: 14px; border: none; border-radius: 10px; background: var(--gold); font-weight: 800; cursor: pointer; color:#000;">Send to Telegram</button>
        </form>
    </div>
</section>

<div id="auth-overlay">
    <div class="auth-container">
        <h2 id="form-title">Login</h2>
        <input type="text" id="name" placeholder="Business Name">
        <input type="email" id="email" placeholder="Email Address">
        <input type="text" id="mobile" placeholder="Mobile Number">
        <input type="password" id="password" placeholder="Password (Min 6 Characters)">
        <span class="forgot-link" id="forgot-password">Forgot Password?</span>
        <input type="text" id="refer" placeholder="Refer code (optional)">
        
        <button id="auth-button">Login</button>
        <p class="switch">Don't have an account? <span id="toggle-form">Signup</span></p>
        <button onclick="closeAuth()" style="background:transparent; color:#666; font-size:12px; margin:0">Cancel</button>
    </div>
</div>

<script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script>
<script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-auth.js"></script>
<script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-database.js"></script>

<script>
// Firebase Config
const firebaseConfig = {
    apiKey: "AIzaSyCZ5P2t5xRhy5d0IXV6UWcvbkUWXqyPENA",
    authDomain: "smbrand-4543a.firebaseapp.com",
    databaseURL: "https://smbrand-4543a-default-rtdb.firebaseio.com",
    projectId: "smbrand-4543a",
    storageBucket: "smbrand-4543a.firebasestorage.app",
    messagingSenderId: "720775550032",
    appId: "1:720775550032:web:0622548a007597778bad55"
};

firebase.initializeApp(firebaseConfig);
const auth = firebase.auth();
const db = firebase.database();

const nameInput = document.getElementById('name');
const emailInput = document.getElementById('email');
const mobileInput = document.getElementById('mobile');
const passwordInput = document.getElementById('password');
const referInput = document.getElementById('refer');
const authButton = document.getElementById('auth-button');
const formTitle = document.getElementById('form-title');
const toggleForm = document.getElementById('toggle-form');
const forgotBtn = document.getElementById('forgot-password');

let isLogin = true;

function openAuth() { document.getElementById('auth-overlay').style.display = 'flex'; }
function closeAuth() { document.getElementById('auth-overlay').style.display = 'none'; }

// Toggle Logic
toggleForm.addEventListener('click', () => {
    isLogin = !isLogin;
    formTitle.innerText = isLogin ? 'Login' : 'Signup';
    authButton.innerText = isLogin ? 'Login' : 'Signup';
    toggleForm.innerText = isLogin ? 'Signup' : 'Login';
    nameInput.style.display = isLogin ? 'none' : 'block';
    mobileInput.style.display = isLogin ? 'none' : 'block';
    referInput.style.display = isLogin ? 'none' : 'block';
    forgotBtn.style.display = isLogin ? 'block' : 'none';
});

// Forgot Password
forgotBtn.addEventListener('click', () => {
    const email = emailInput.value.trim();
    if(!email) { alert("Please enter email first!"); return; }
    auth.sendPasswordResetEmail(email, { url: window.location.href, handleCodeInApp: true })
    .then(() => alert("✅ Reset link sent to your email!"))
    .catch(err => alert(err.message));
});

// Auto Redirect
auth.onAuthStateChanged(user => {
    if(user){
        // Yahan location 'devloper' ya 'devloper' par bhej raha hai
        window.location.href = (user.email === "rajputsurendra562@gmail.com") ? "devi" : "devi";
    }
});

document.getElementById('contactForm').onsubmit = async (e) => {
    e.preventDefault();
    const btn = e.target.querySelector('button');
    btn.innerText = "Sending...";

    const data = {
        name: document.getElementById('c-name').value,
        email: document.getElementById('c-email').value,
        mobile: document.getElementById('c-mobile').value,
        need: document.getElementById('c-need').value,
        msg: document.getElementById('c-message').value
    };

    try {
        // Bhai yahan apna Vercel backend URL dalna
        const response = await fetch('https://money-card-p.vercel.app/api/contact-telegram', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        if (response.ok) {
            alert("🚀 Message sent to our Telegram Bot! We will contact you soon.");
            e.target.reset();
        } else { alert("Error sending message."); }
    } catch (err) { alert("Server Error."); }
    btn.innerText = "Send to Telegram";
};



// Main Auth Logic
authButton.addEventListener('click', async () => {
    const email = emailInput.value.trim();
    const password = passwordInput.value.trim();

    if(isLogin){
        auth.signInWithEmailAndPassword(email, password).catch(err => alert(err.message));
    } else {
        const name = nameInput.value.trim();
        const mobile = mobileInput.value.trim();
        const referFromFriend = referInput.value.trim();

        if(!name || !mobile || !email || !password){ alert("Fill all fields!"); return; }

        try {
            const cred = await auth.createUserWithEmailAndPassword(email, password);
            const uid = cred.user.uid;
            const isAdmin = (email === "rajputsurendra562@gmail.com");
            const userReferCode = 'R' + Math.floor(100000 + Math.random() * 900000);

            await db.ref("users/" + uid).set({
                name, email, mobile,
                refer: userReferCode,
                refer_from: referFromFriend || null,
                role: isAdmin ? "admin" : "user",
                wallet: isAdmin ? 0 : 100,
                created_at: Date.now()
            });
            alert("Signup Successful!");
        } catch(err){ alert(err.message); }
    }
});

// Default UI State
nameInput.style.display = 'none';
mobileInput.style.display = 'none';
referInput.style.display = 'none';
</script>
</body>
</html>
