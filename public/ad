<!DOCTYPE html>
<html lang="en">
<head>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-auth.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-database.js"></script>
    <title>MoneyCard Pro | Instant</title>
    <style>
        .active-tab { background: #f0fdf4; color: #10b981; border-right: 4px solid #10b981; }
        .hide { display: none; }
    </style>
</head>
<body class="bg-[#F8FAFB] text-slate-800 font-sans h-screen flex overflow-hidden">

    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyCZ5P2t5xRhy5d0IXV6UWcvbkUWXqyPENA",
            authDomain: "smbrand-4543a.firebaseapp.com",
            databaseURL: "https://smbrand-4543a-default-rtdb.firebaseio.com",
            projectId: "smbrand-4543a",
            appId: "1:720775550032:web:0622548a007597778bad55"
        };
        firebase.initializeApp(firebaseConfig);
        const auth = firebase.auth();
        const rtdb = firebase.database();
    </script>

    <div id="login-sec" class="fixed inset-0 bg-white z-[100] flex items-center justify-center p-6">
        <div class="max-w-sm w-full space-y-6 text-center">
            <h1 class="text-4xl font-black text-emerald-600 italic">MoneyCard.</h1>
            <div class="space-y-3">
                <input type="email" id="l-email" placeholder="EMAIL" class="w-full p-4 bg-slate-50 border border-slate-100 rounded-2xl outline-none focus:ring-2 ring-emerald-500 font-bold">
                <input type="password" id="l-pass" placeholder="PASSWORD" class="w-full p-4 bg-slate-50 border border-slate-100 rounded-2xl outline-none focus:ring-2 ring-emerald-500 font-bold">
            </div>
            <button onclick="handleAuth()" id="login-btn" class="w-full py-4 bg-slate-900 text-white font-black rounded-2xl shadow-xl hover:bg-emerald-600 transition-all uppercase tracking-widest">Sign In</button>
        </div>
    </div>

    <nav id="nav-sec" class="w-20 hover:w-64 transition-all duration-300 bg-white border-r border-slate-200 flex flex-col py-8 z-50 group hide">
        <div class="px-6 mb-12 font-black text-2xl text-emerald-600 italic">M.</div>
        <div class="flex-1 space-y-2">
            <button onclick="showTab('wallets')" id="t-wallets" class="sidebar-item active-tab flex items-center w-full px-6 py-4 transition-all">
                <span class="text-xl">💳</span>
                <span class="label opacity-0 ml-4 font-bold text-[10px] uppercase tracking-widest whitespace-nowrap transition-all">Wallets</span>
            </button>
            <button onclick="showTab('swap')" id="t-swap" class="sidebar-item flex items-center w-full px-6 py-4 transition-all hover:bg-slate-50">
                <span class="text-xl">🔄</span>
                <span class="label opacity-0 ml-4 font-bold text-[10px] uppercase tracking-widest whitespace-nowrap transition-all">Exchange</span>
            </button>
            <button onclick="logout()" class="flex items-center w-full px-6 py-4 hover:bg-red-50 text-red-400 transition-all">
                <span class="text-xl">🚪</span>
                <span class="label opacity-0 ml-4 font-bold text-[10px] uppercase tracking-widest whitespace-nowrap transition-all">Logout</span>
            </button>
        </div>
    </nav>

    <main id="main-sec" class="flex-1 overflow-y-auto p-8 lg:p-16 hide">
        <div class="max-w-5xl mx-auto">
            <header class="flex justify-between items-end mb-12">
                <div>
                    <h2 class="text-slate-400 text-[10px] font-black uppercase tracking-[0.3em] mb-1">Total Balance</h2>
                    <h1 id="total-val" class="text-6xl font-black text-slate-900 tracking-tighter">0.00 <span class="text-2xl text-slate-200">USDT</span></h1>
                </div>
            </header>
            
            <section id="sec-wallets">
                <div class="bg-white rounded-[3rem] border border-slate-100 shadow-sm overflow-hidden">
                    <div id="coin-list" class="divide-y divide-slate-50"></div>
                </div>
            </section>

            <section id="sec-swap" class="hide max-w-xl mx-auto bg-white p-10 rounded-[3.5rem] shadow-2xl border border-slate-100">
                <h2 class="text-2xl font-black italic uppercase mb-10 text-center">Exchange</h2>
                <div class="space-y-4">
                    <div class="p-6 bg-slate-50 rounded-3xl border border-slate-100">
                        <input type="number" id="s-amt" oninput="doCalc()" value="1" class="w-full bg-transparent text-3xl font-black outline-none">
                        <select id="s-from" onchange="doCalc()" class="w-full mt-4 bg-white p-3 rounded-xl font-bold uppercase"></select>
                    </div>
                    <div class="p-6 bg-emerald-50/50 rounded-3xl border border-emerald-100">
                        <div id="s-res" class="text-3xl font-black text-emerald-600">0.00</div>
                        <select id="s-to" onchange="doCalc()" class="w-full mt-4 bg-white p-3 rounded-xl font-bold uppercase"></select>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <div id="dep-modal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-md hidden z-[100] flex items-center justify-center p-6">
        <div class="bg-white p-10 rounded-[4rem] max-w-sm w-full shadow-2xl text-center space-y-6">
            <h3 id="dep-title" class="text-xl font-black uppercase italic"></h3>
            <img id="qr-img" class="w-48 h-48 mx-auto rounded-xl shadow-lg">
            <div class="bg-slate-50 p-4 rounded-2xl text-left border border-slate-100">
                <p id="addr-txt" class="font-mono text-[10px] text-slate-600 break-all font-bold">Generating...</p>
            </div>
            <button onclick="closeDep()" class="w-full py-4 bg-slate-100 text-slate-400 rounded-2xl font-black text-[10px] tracking-widest uppercase">Close</button>
        </div>
    </div>

    <script>
        const API = "https://money-card-p.vercel.app/api";
        const COINS = ['USDT', 'TRX', 'BTC', 'ETH', 'BNB', 'SOL', 'LTC', 'MATIC', 'DOGE', 'SHIB', 'ADA', 'XRP', 'DOT', 'AVAX', 'LINK', 'TRON', 'BCH', 'XLM', 'ATOM', 'UNI'];

        // AUTH LISTENER: Seedha switch karega dashboard par
        auth.onAuthStateChanged((user) => {
            if (user) {
                document.getElementById('login-sec').classList.add('hide');
                document.getElementById('nav-sec').classList.remove('hide');
                document.getElementById('main-sec').classList.remove('hide');
                init(); // Dashboard load login ke BAAD
            } else {
                document.getElementById('login-sec').classList.remove('hide');
                document.getElementById('nav-sec').classList.add('hide');
                document.getElementById('main-sec').classList.add('hide');
            }
        });

        // LOGIN: No backend call here, direct Firebase hit
        async function handleAuth() {
            const email = document.getElementById('l-email').value;
            const pass = document.getElementById('l-pass').value;
            const btn = document.getElementById('login-btn');
            if(!email || !pass) return alert("Enter credentials");
            btn.innerText = "AUTHENTICATING...";
            try {
                await auth.signInWithEmailAndPassword(email, pass);
            } catch (e) {
                alert(e.message);
                btn.innerText = "SIGN IN";
            }
        }

        async function init() {
            try {
                const [balRes, priceRes] = await Promise.all([
                    fetch(`${API}/oxa/balance`),
                    fetch(`${API}/oxa/prices`)
                ]);
                const balData = await balRes.json();
                const priceData = await priceRes.json();
                
                const list = document.getElementById('coin-list');
                const sFrom = document.getElementById('s-from');
                const sTo = document.getElementById('s-to');
                list.innerHTML = ""; sFrom.innerHTML = ""; sTo.innerHTML = "";

                COINS.forEach(c => {
                    const bal = balData.data?.[c] || "0.00";
                    const price = priceData.data?.find(curr => curr.symbol === c)?.price || "0.00";
                    list.innerHTML += `
                        <div onclick="openDep('${c}')" class="grid grid-cols-4 items-center p-8 hover:bg-slate-50 cursor-pointer group">
                            <div class="col-span-2 flex items-center gap-6">
                                <img src="https://raw.githubusercontent.com/spothq/cryptocurrency-icons/master/128/color/${c.toLowerCase()}.png" class="w-10 h-10">
                                <span class="font-black uppercase italic">${c}</span>
                            </div>
                            <div class="font-bold text-slate-300">$${parseFloat(price).toFixed(2)}</div>
                            <div class="text-right font-black text-emerald-500 text-lg">${parseFloat(bal).toFixed(2)}</div>
                        </div>
                    `;
                    sFrom.innerHTML += `<option value="${c}">${c}</option>`;
                    sTo.innerHTML += `<option value="${c}">${c}</option>`;
                });
                document.getElementById('total-val').innerHTML = `${balData.data?.USDT || "0.00"} <span class="text-2xl text-slate-200 ml-2">USDT</span>`;
            } catch (err) { console.error("Data error"); }
        }

        async function openDep(coin) {
            document.getElementById('dep-modal').classList.remove('hidden');
            document.getElementById('dep-title').innerText = "Receive " + coin;
            const user = auth.currentUser;
            const res = await fetch(`${API}/oxa/static`, { 
                method: 'POST', 
                headers: {'Content-Type':'application/json'}, 
                body: JSON.stringify({userId: user.uid, coin: coin}) 
            });
            const d = await res.json();
            document.getElementById('qr-img').src = d.data.qr_code;
            document.getElementById('addr-txt').innerText = d.data.address;
        }

        async function doCalc() {
            const res = await fetch(`${API}/oxa/calculate`, {
                method: 'POST',
                headers: {'Content-Type':'application/json'},
                body: JSON.stringify({ from_currency: document.getElementById('s-from').value, to_currency: document.getElementById('s-to').value, amount: document.getElementById('s-amt').value })
            });
            const d = await res.json();
            document.getElementById('s-res').innerText = d.data.to_amount || "0.00";
        }

        function logout() { auth.signOut(); }
        function closeDep() { document.getElementById('dep-modal').classList.add('hidden'); }
        function showTab(id) {
            document.getElementById('sec-wallets').classList.toggle('hide', id !== 'wallets');
            document.getElementById('sec-swap').classList.toggle('hide', id !== 'swap');
        }
    </script>
</body>
</html>
