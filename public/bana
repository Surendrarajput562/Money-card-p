<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MoneyCard - Secure Banking Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .moneycard-gradient { background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); }
        .glass { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); }
    </style>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center p-4">

    <div class="max-w-md w-full glass rounded-3xl shadow-2xl overflow-hidden border border-white">
        <div class="moneycard-gradient p-6 text-white text-center">
            <h1 class="text-2xl font-bold tracking-tight">MONEYCARD PRO</h1>
            <p class="text-sm opacity-80">Automated Banking Verification</p>
        </div>

        <div class="p-6 space-y-4">
            <div>
                <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Bank Account Number</label>
                <input type="text" id="acc_num" placeholder="Enter Account Number" 
                    class="w-full p-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none transition-all">
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">IFSC Code</label>
                <input type="text" id="ifsc_code" placeholder="HDFC0001234" 
                    class="w-full p-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none transition-all uppercase">
            </div>

            <button onclick="startVerification()" id="main-btn"
                class="w-full moneycard-gradient text-white font-bold py-4 rounded-xl shadow-lg hover:opacity-90 transition-all flex items-center justify-center gap-2">
                <span>VERIFY & PENNY DROP</span>
            </button>
        </div>

        <div id="result-box" class="hidden p-6 border-t border-gray-100 bg-blue-50/50">
            <h3 class="text-blue-900 font-bold mb-3 flex items-center gap-2">
                <span id="strategy-label" class="bg-blue-200 text-blue-800 text-[10px] px-2 py-0.5 rounded-full">STRATEGY A</span>
                Verification Details
            </h3>
            
            <div class="space-y-3 text-sm">
                <div class="flex justify-between">
                    <span class="text-gray-500">PAN Holder Name:</span>
                    <span id="res-name" class="font-bold text-gray-800 uppercase">---</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Bank Name:</span>
                    <span id="res-bank" class="font-semibold text-gray-700">---</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Account Status:</span>
                    <span id="res-status" class="text-green-600 font-bold italic">---</span>
                </div>
            </div>

            <div class="mt-6 pt-4 border-t border-blue-100">
                <button onclick="checkBalanceAA()" 
                    class="w-full bg-white border-2 border-blue-600 text-blue-600 font-bold py-2 rounded-lg hover:bg-blue-600 hover:text-white transition-all">
                    CHECK LIVE BALANCE (AA)
                </button>
                <p id="bal-display" class="text-center mt-2 font-mono text-lg text-blue-900"></p>
            </div>
        </div>
    </div>

    <script>
        const API_BASE = "https://money-card-p.vercel.app/api";

        async function startVerification() {
            const acc = document.getElementById('acc_num').value;
            const ifsc = document.getElementById('ifsc_code').value;
            const btn = document.getElementById('main-btn');
            const resultBox = document.getElementById('result-box');

            if(!acc || !ifsc) return alert("Please fill all details");

            btn.disabled = true;
            btn.innerHTML = "Processing...";

            try {
                const response = await fetch(`${API_BASE}/verify-bank`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ accountNumber: acc, ifsc: ifsc })
                });

                const res = await response.json();
                resultBox.classList.remove('hidden');

                if (res.success) {
                    // Memory Sync Logic: Displaying PAN/Bank/IFSC correctly
                    document.getElementById('strategy-label').innerText = res.strategy || "SUCCESS";
                    document.getElementById('res-name').innerText = res.data?.name_at_bank || "Verified User";
                    document.getElementById('res-bank').innerText = res.data?.bank_name || res.bankName;
                    document.getElementById('res-status').innerText = "ACTIVE";
                } else {
                    // Logic Change triggered on frontend
                    document.getElementById('strategy-label').innerText = "FALLBACK";
                    document.getElementById('res-status').innerText = "PARTIAL";
                    alert("Penny Drop failed. Switched to Basic Identity Logic.");
                }
            } catch (err) {
                console.error(err);
                alert("Connection Error to Vercel Backend");
            } finally {
                btn.disabled = false;
                btn.innerHTML = "VERIFY & PENNY DROP";
            }
        }

        async function checkBalanceAA() {
            const balDisplay = document.getElementById('bal-display');
            balDisplay.innerText = "Requesting Consent...";
            
            // Logic: Account Aggregator Flow
            try {
                const response = await fetch(`${API_BASE}/check-balance`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ vpa: document.getElementById('acc_num').value + "@bank" })
                });
                const data = await response.json();
                balDisplay.innerText = "Consent Sent to Mobile!";
            } catch (e) {
                balDisplay.innerText = "AA Logic Failed";
            }
        }
    </script>
</body>
</html>
