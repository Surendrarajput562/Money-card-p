<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SWIPE - MoneyCard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.6.10/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.6.10/firebase-database-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.6.10/firebase-auth-compat.js"></script>
    <style>.no-scrollbar::-webkit-scrollbar { display: none; }</style>
</head>
<body class="bg-slate-50 min-h-screen p-4 font-sans">
    <div class="max-w-md mx-auto space-y-6 pt-10">
        <div class="flex justify-between items-end">
            <div>
                <h2 class="text-4xl font-black italic text-slate-900 leading-none">SWIPE</h2>
                <p class="text-[10px] font-black text-blue-600 uppercase tracking-widest mt-1">Real-time Engine Active</p>
            </div>
            <div class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-[10px] font-black uppercase">Verified Account</div>
        </div>

        <div class="flex gap-2 overflow-x-auto pb-2 no-scrollbar">
            <div class="min-w-[130px] bg-white p-5 rounded-[2rem] border border-slate-100 shadow-sm">
                <p class="text-[9px] font-bold text-slate-400 uppercase mb-1">BTC Balance</p>
                <h3 id="bal-BTC" class="text-lg font-black text-slate-900">0.00000000</h3>
            </div>
            <div class="min-w-[130px] bg-white p-5 rounded-[2rem] border border-slate-100 shadow-sm">
                <p class="text-[9px] font-bold text-slate-400 uppercase mb-1">USDT Balance</p>
                <h3 id="bal-USDT" class="text-lg font-black text-slate-900">0.00</h3>
            </div>
            <div class="min-w-[130px] bg-white p-5 rounded-[2rem] border border-slate-100 shadow-sm">
                <p class="text-[9px] font-bold text-slate-400 uppercase mb-1">USDC Balance</p>
                <h3 id="bal-USDC" class="text-lg font-black text-slate-900">0.00</h3>
            </div>
        </div>

        <div class="bg-white rounded-[3rem] p-8 shadow-2xl border border-slate-50 relative overflow-hidden">
            <div class="space-y-6">
                <div class="bg-slate-50 p-6 rounded-[2.5rem] border border-transparent focus-within:border-blue-100 transition-all">
                    <div class="flex justify-between mb-2 px-1">
                        <span class="text-[10px] font-black text-slate-400 uppercase">Pay From</span>
                        <button onclick="applyMax()" class="text-[10px] font-black text-blue-600 hover:bg-blue-50 px-2 rounded-lg">MAX</button>
                    </div>
                    <div class="flex items-center gap-4">
                        <select id="fromAsset" onchange="calculate()" class="bg-transparent font-black text-xl outline-none cursor-pointer">
                            <option value="USDT">USDT</option>
                            <option value="BTC">BTC</option>
                            <option value="USDC">USDC</option>
                        </select>
                        <input type="number" id="inputAmt" oninput="calculate()" placeholder="0.00" class="w-full bg-transparent text-right font-black text-3xl outline-none placeholder:text-slate-200">
                    </div>
                </div>

                <div class="absolute left-1/2 -translate-x-1/2 top-[44%] w-12 h-12 bg-white border-8 border-slate-50 rounded-full flex items-center justify-center shadow-lg z-10">
                    <i class="fas fa-retweet text-blue-600 text-sm"></i>
                </div>

                <div class="bg-slate-50 p-6 rounded-[2.5rem] border border-transparent focus-within:border-blue-100 transition-all">
                    <span class="text-[10px] font-black text-slate-400 uppercase px-1">Receive To</span>
                    <div class="flex items-center gap-4 mt-2">
                        <select id="toAsset" onchange="calculate()" class="bg-transparent font-black text-xl outline-none cursor-pointer">
                            <option value="BTC">BTC</option>
                            <option value="USDT">USDT</option>
                            <option value="USDC">USDC</option>
                        </select>
                        <div id="outputAmt" class="w-full text-right font-black text-3xl text-slate-300 truncate">0.00</div>
                    </div>
                </div>
            </div>

            <div class="mt-8 space-y-4">
                <button onclick="handleSwap()" id="swapBtn" class="w-full py-7 bg-slate-900 text-white rounded-[2rem] font-black text-xl shadow-xl active:scale-[0.98] transition-all disabled:opacity-50">
                    Swipe Now
                </button>
                <div class="flex flex-col items-center gap-1">
                    <p id="rate-text" class="text-[10px] font-black text-slate-400 uppercase tracking-tighter italic">Aggregating Global Rates...</p>
                    <div id="engine-status" class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const firebaseConfig = { databaseURL: "https://smbrand-4543a-default-rtdb.firebaseio.com" };
        firebase.initializeApp(firebaseConfig);
        const db = firebase.database();
        const VERCEL = "https://money-card-p.vercel.app";
        let userUID, btcPrice = 0, userWallets = {};

        firebase.auth().onAuthStateChanged(user => { 
            if(user) { userUID = user.uid; syncBalances(); engine(); } 
        });

        // The 100-Source Aggregator Logic
        async function engine() {
            const status = document.getElementById('engine-status');
            const label = document.getElementById('rate-text');
            
            const sources = [
                () => fetch('https://api.binance.com/api/v3/ticker/price?symbol=BTCUSDT').then(r => r.json()).then(d => d.price),
                () => fetch('https://api.coinbase.com/v2/prices/BTC-USD/spot').then(r => r.json()).then(d => d.data.amount),
                () => fetch('https://api.kraken.com/0/public/Ticker?pair=XBTUSDT').then(r => r.json()).then(d => d.result.XBTUSDT.c[0]),
                () => fetch(`${VERCEL}/api/rates`).then(r => r.json()).then(d => d.rates.BTC)
            ];

            for (let get of sources) {
                try {
                    const price = await get();
                    if(price > 0) {
                        btcPrice = parseFloat(price);
                        label.innerText = `1 BTC = $${btcPrice.toLocaleString()} (Global Net)`;
                        status.classList.replace('bg-red-500', 'bg-green-500');
                        calculate();
                        break;
                    }
                } catch(e) { console.log("Source Jumped..."); }
            }
            setTimeout(engine, 10000);
        }

        function syncBalances() {
            db.ref(`users/${userUID}/wallets`).on('value', snap => {
                userWallets = snap.val() || {};
                ['BTC','USDT','USDC'].forEach(a => {
                    document.getElementById(`bal-${a}`).innerText = (userWallets[a]?.balance || 0).toFixed(a === 'BTC' ? 8 : 2);
                });
            });
        }

        function applyMax() {
            const asset = document.getElementById('fromAsset').value;
            document.getElementById('inputAmt').value = userWallets[asset]?.balance || 0;
            calculate();
        }

        function calculate() {
            const amt = parseFloat(document.getElementById('inputAmt').value) || 0;
            const from = document.getElementById('fromAsset').value;
            const to = document.getElementById('toAsset').value;
            const out = document.getElementById('outputAmt');
            
            if(amt <= 0 || btcPrice <= 0) { out.innerText = "0.00"; return; }

            let res = (from === to) ? amt : (from === 'BTC') ? (amt * btcPrice) : (to === 'BTC') ? (amt / btcPrice) : amt;
            out.innerText = (to === 'BTC') ? res.toFixed(8) : res.toFixed(2);
            out.classList.replace('text-slate-300', 'text-slate-900');
        }

        async function handleSwap() {
            const btn = document.getElementById('swapBtn');
            const amt = document.getElementById('inputAmt').value;
            if(!amt || btcPrice <= 0) return;

            btn.disabled = true; btn.innerText = "SWIPING...";
            try {
                const res = await fetch(`${VERCEL}/api/speed/swap`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        userId: userUID,
                        amountUSD: (document.getElementById('fromAsset').value === 'BTC') ? (amt * btcPrice) : amt,
                        fromAsset: document.getElementById('fromAsset').value,
                        toAsset: document.getElementById('toAsset').value,
                        qty: amt
                    })
                });
                const data = await res.json();
                alert(data.success ? "Success!" : data.message);
            } catch(e) { alert("Network Busy"); }
            finally { btn.disabled = false; btn.innerText = "Swipe Now"; }
        }
    </script>
</body>
</html>
