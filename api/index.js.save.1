app.post('/api/create-order', async (req, res) => {
    // Saare purane fields waise hi hain
    const { 
        user_uid, internal_id, txn_amount, txn_note, product_name, 
        customer_name, customer_mobile, customer_email, type, 
        redirect_url, order_address, order_items, plan_id, plan_name 
    } = req.body;

    if (!user_uid || !internal_id || !txn_amount) {
        return res.status(400).json({ success: false, message: "Required fields missing." });
    }

    const allapi_order_id = `ALLAPI_${type}_${internal_id}_${Date.now()}`;
    const cf_order_id = `CF_${internal_id}_${Date.now()}`;

    try {
        // --- 1. ALLAPI LOGIC (Pehele ye chalega) ---
        try {
            // Aapka mapping logic (Nahi kata gaya)
            await db.ref(`allapi_transactions_mapping/${allapi_order_id}`).set({
                user_uid, internal_id, type, txn_amount,
                status: 'pending',
                created_at: admin.database.ServerValue.TIMESTAMP,
                customer_name, customer_mobile, customer_email,
                plan_id: plan_id || null,
                plan_name: plan_name || null,
                order_address: type === 'cart' ? order_address : null,
                order_items: type === 'cart' ? order_items : null
            });

            const allapiRes = await axios.post('https://allapi.in/order/create', {
                token: ALLAPI_TOKEN,
                order_id: allapi_order_id,
                txn_amount: txn_amount,
                txn_note: txn_note || "Gold Rupi Order",
                product_name: product_name || txn_note,
                customer_name, customer_mobile, customer_email,
                redirect_url
            });

            if (allapiRes.data.status) {
                await db.ref(`allapi_transactions_mapping/${allapi_order_id}`).update({
                    gateway_txn_id: allapiRes.data.results.txn_id,
                    payment_url: allapiRes.data.results.payment_url,
                    status: 'awaiting_payment'
                });

                return res.status(200).json({
                    success: true,
                    results: {
                        payment_gateway: 'allapi',
                        allapi_order_id: allapi_order_id,
                        txn_id: allapiRes.data.results.txn_id,
                        payment_url: allapiRes.data.results.payment_url
                    }
                });
            } else {
                throw new Error("ALLAPI_PLAN_ERROR"); // Plan nahi hai toh yahan se switch hoga
            }
        } catch (apiErr) {
            console.log("AllAPI Failed or Plan Expired. Switching to Cashfree...");
        }

        // --- 2. CASHFREE LOGIC (Fallback - Agar AllAPI fail ho) ---
        const cleanPhone = String(customer_mobile || "").replace(/\D/g, '').slice(-10);
        
        // Cashfree mapping (Nahi kati gayi)
        await db.ref(`cashfree_transactions_mapping/${cf_order_id}`).set({
            user_uid,
            plan_name: plan_name || "standard",
            amount: parseFloat(txn_amount),
            status: 'awaiting_payment',
            created_at: admin.database.ServerValue.TIMESTAMP
        });

        const cfResponse = await axios.post('https://api.cashfree.com/pg/orders', {
            order_id: cf_order_id,
            order_amount: parseFloat(txn_amount).toFixed(2),
            order_currency: "INR",
            customer_details: {
                customer_id: user_uid,
                customer_phone: cleanPhone,
                customer_name: (customer_name || "User").replace(/[^a-zA-Z ]/g, "").trim(),
                customer_email: customer_email || "user@moneycard.app"
            },
            order_meta: {
                return_url: `${redirect_url}?order_id=${internal_id}`
            }
        }, {
            headers: {
                'x-client-id': CASHFREE_GETWEYAPPID,
                'x-client-secret': CASHFREE_GETWEYSECRET,
                'x-api-version': '2023-08-01',
                'Content-Type': 'application/json'
            }
        });

        const cf = cfResponse.data;
        await db.ref(`cashfree_transactions_mapping/${cf_order_id}`).update({
            cf_order_id: cf.cf_order_id,
            payment_session_id: cf.payment_session_id,
            status: 'initiated'
        });

        return res.status(200).json({
            success: true,
            results: {
                payment_gateway: 'cashfree',
                payment_session_id: cf.payment_session_id,
                order_id: cf_order_id
            }
        });

    } catch (finalErr) {
        console.error("CRITICAL_ERROR:", finalErr.response?.data || finalErr.message);
        res.status(500).json({ success: false, message: "Both gateways are currently down." });
    }
});


