app.post('/api/create-order', async (req, res) => {
    const { user_uid, internal_id, txn_amount, txn_note, product_name, customer_name, customer_mobile, customer_email, type, redirect_url, order_address, order_items, plan_id, plan_name } = req.body;

    if (!ALLAPI_TOKEN) return res.status(500).json({ success: false, message: "AllAPI.in token is not configured on backend." });
    if (!user_uid || !internal_id || !txn_amount || !txn_note || !customer_name || !customer_mobile || !type || !redirect_url) {
        return res.status(400).json({ success: false, message: "Missing required fields for AllAPI.in order creation." });
    }

    // Generate a unique order_id for AllAPI.in (it requires its own unique ID)
    const allapi_order_id = `ALLAPI_${type}_${internal_id}_${Date.now()}`;

    try {
        // Step 1: Store mapping in Firebase for webhook reconciliation
        await db.ref(`allapi_transactions_mapping/${allapi_order_id}`).set({
            user_uid: user_uid,
            internal_id: internal_id,
            type: type,
            txn_amount: txn_amount,
            status: 'pending',
            created_at: admin.database.ServerValue.TIMESTAMP,
            customer_name: customer_name,
            customer_mobile: customer_mobile,
            customer_email: customer_email,
            plan_id: plan_id || null, // For subscription type
            plan_name: plan_name || null, // For subscription type
            order_address: type === 'cart' ? order_address : null,
            order_items: type === 'cart' ? order_items : null
        });

        // Step 2: Call AllAPI.in to create the payment order
        const allapiResponse = await axios.post('https://allapi.in/order/create', {
            token: ALLAPI_TOKEN,
            order_id: allapi_order_id,
            txn_amount: txn_amount,
            txn_note: txn_note,
            product_name: product_name || txn_note,
            customer_name: customer_name,
            customer_mobile: customer_mobile,
            customer_email: customer_email,
            redirect_url: redirect_url
        });

        if (allapiResponse.data.status) {
            await db.ref(`allapi_transactions_mapping/${allapi_order_id}`).update({
                gateway_txn_id: allapiResponse.data.results.txn_id,
                payment_url: allapiResponse.data.results.payment_url,
                status: 'awaiting_payment',
                updated_at: admin.database.ServerValue.TIMESTAMP
            });

            return res.status(200).json({
                success: true,
                message: "Order created successfully with AllAPI.in",
                results: {
                    allapi_order_id: allapi_order_id,
                    txn_id: allapiResponse.data.results.txn_id,
                    payment_url: allapiResponse.data.results.payment_url,
                    upi_intent: allapiResponse.data.results.upi_intent
                }
            });
        } else {
            console.error("AllAPI.in Error:", allapiResponse.data);
            await db.ref(`allapi_transactions_mapping/${allapi_order_id}`).update({
                status: 'failed_initiation',
                gateway_response: allapiResponse.data,
                updated_at: admin.database.ServerValue.TIMESTAMP
            });
            return res.status(400).json({ success: false, message: allapiResponse.data.message || "Failed to create order with AllAPI.in" });
        }

    } catch (error) {
        console.error("Error creating AllAPI.in order:", error.response ? error.response.data : error.message);
        if (allapi_order_id) {
            await db.ref(`allapi_transactions_mapping/${allapi_order_id}`).update({
                status: 'backend_api_error',
                error_details: error.response ? error.response.data : error.message,
                updated_at: admin.database.ServerValue.TIMESTAMP
            });
        }
        return res.status(500).json({ success: false, message: "Backend error during order creation." });
    }
});
app.post('/api/pay', async (req, res) => {
    let orderId = ""; 
    try {
        const { amount, phone, name, user_uid, plan_id, plan_name } = req.body;
        const cleanPhone = String(phone || "").replace(/\D/g, '').slice(-10);
        orderId = `CF_${plan_id || 'sub'}_${user_uid || 'anon'}_${Date.now()}`;

        // 1. Initial Entry with basic data
        await db.ref(`cashfree_transactions_mapping/${orderId}`).set({
            user_uid: user_uid || "unknown",
            plan_name: plan_name || "standard",
            amount: parseFloat(amount || 0),
            status: 'awaiting_payment',
            created_at: admin.database.ServerValue.TIMESTAMP
        });

        // 2. Cashfree API Call
        const response = await axios.post('https://api.cashfree.com/pg/orders', {
            order_id: orderId,
            order_amount: parseFloat(amount).toFixed(2),
            order_currency: "INR",
            customer_details: {
                customer_id: user_uid || "CUST_" + Date.now(),
                customer_phone: cleanPhone,
                customer_name: (name || "User").replace(/[^a-zA-Z ]/g, "").trim()
            },
            order_meta: {
                return_url: `https://moneycard-8f457.web.app/dashboard.html?order_id=${orderId}`
            }
        }, {
            headers: {
                'x-client-id': CASHFREE_GETWEYAPPID,
                'x-client-secret': CASHFREE_GETWEYSECRET,
                'x-api-version': '2023-08-01',
                'Content-Type': 'application/json'
            }
        });

        // 3. CLEAN UPDATE LOGIC (Filters out undefined/null)
        const cf = response.data;
        const rawUpdate = {
            cf_order_id: cf.cf_order_id,
            payment_session_id: cf.payment_session_id,
            payment_link: cf.payment_link || null, // null is allowed, undefined is not
            status: 'initiated',
            updated_at: admin.database.ServerValue.TIMESTAMP
        };

        // Remove any keys that are still undefined
        const cleanUpdate = Object.fromEntries(
            Object.entries(rawUpdate).filter(([_, v]) => v !== undefined)
        );

        await db.ref(`cashfree_transactions_mapping/${orderId}`).update(cleanUpdate);

        // 4. Return to Frontend
        res.status(200).json({
            success: true,
            payment_session_id: cf.payment_session_id,
            order_id: orderId
        });

    } catch (error) {
        const errorData = error.response ? error.response.data : error.message;
        console.error("CASHFREE_ERROR:", errorData);
        
        if (orderId) {
            await db.ref(`cashfree_transactions_mapping/${orderId}`).update({
                status: 'failed',
                error: typeof errorData === 'string' ? errorData : "Gateway Rejected"
            }).catch(() => {});
        }
        res.status(400).json({ success: false, message: "Payment Initiation Failed" });
    }
});













