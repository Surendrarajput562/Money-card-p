// --- SHIPROCKET AUTHENTICATION ---
let shiprocketToken = null;
let shiprocketTokenExpiry = 0;

async function getShiprocketToken() {
    if (shiprocketToken && Date.now() < shiprocketTokenExpiry) {
        return shiprocketToken;
    }

    try {
        const response = await axios.post('https://apiv2.shiprocket.in/v1/external/auth/login', {
            email: SHIPROCKET_EMAIL,
            password: SHIPROCKET_PASSWORD
        });
        shiprocketToken = response.data.token;
        shiprocketTokenExpiry = Date.now() + (response.data.expires_in * 1000); // Convert seconds to milliseconds
        console.log('Shiprocket token refreshed.');
        return shiprocketToken;
    } catch (error) {
        console.error('Failed to get Shiprocket token:', error.response ? error.response.data : error.message);
        throw new Error('Shiprocket authentication failed.');
    }
}


// --- SHIPROCKET ORDER CREATION (THIS FUNCTION IS EXPORTED FOR WEBHOOK.JS) ---
async function createShiprocketOrder(orderData, customerAddress, customerDetails) {
    try {
        if (!SHIPROCKET_EMAIL || !SHIPROCKET_PASSWORD) {
            console.warn('Shiprocket credentials are not configured. Skipping order creation.');
            return {
                shiprocket_order_id: null,
                tracking_id: null,
                tracking_url: null,
                shiprocket_status: 'SKIPPED_NO_CREDENTIALS',
                message: 'Shiprocket credentials missing.'
            };
        }

        const token = await getShiprocketToken();
        const shiprocketOrderItems = Object.values(orderData.items).map(item => ({
            name: item.name,
            sku: item.id, // Using product ID as SKU
            units: item.quantity,
            selling_price: item.final_price,
            discount: item.price - item.final_price,
            tax: 0, // Assuming tax is handled externally or not applicable
            hsn: 4202, // Placeholder, ideally from product data
        }));

        const srPayload = {
            order_id: orderData.id, // Your internal order ID as Shiprocket order ID
            order_date: new Date(orderData.created_at).toISOString().split('T')[0], // YYYY-MM-DD
            pickup_address: "Default", // You need to configure pickup locations in Shiprocket and choose one
            channel_id: "", // Optional: If you have specific sales channels
            comment: `Payment received via AllAPI.in (Txn ID: ${orderData.gateway_txn_id || 'N/A'})`,
            billing_customer_name: customerDetails.customer_name || 'User',
            billing_address: customerAddress.house,
            billing_address_2: `${customerAddress.city}, ${customerAddress.district}`,
            billing_city: customerAddress.city,
            billing_pincode: customerAddress.pincode || "110001", // Use actual pincode
            billing_state: customerAddress.state || 'Delhi', // Use actual state
            billing_country: customerAddress.country || 'India',
            billing_email: customerDetails.customer_email || 'user@example.com',
            billing_phone: customerDetails.customer_mobile || '9999999999',
            shipping_customer_name: customerDetails.customer_name || 'User',
            shipping_address: customerAddress.house,
            shipping_address_2: `${customerAddress.city}, ${customerAddress.district}`,
            shipping_city: customerAddress.city,
            shipping_pincode: customerAddress.pincode || "110001", // Use actual pincode
            shipping_state: customerAddress.state || 'Delhi', // Use actual state
            shipping_country: customerAddress.country || 'India',
            shipping_email: customerDetails.customer_email || 'user@example.com',
            shipping_phone: customerDetails.customer_mobile || '9999999999',
            order_items: shiprocketOrderItems,
            payment_method: "Prepaid", // Assuming AllAPI.in means prepaid
            shipping_charges: 0,
            giftwrap_charges: 0,
            transaction_charges: 0,
            total_discount: shiprocketOrderItems.reduce((sum, item) => sum + item.discount, 0),
            sub_total: orderData.total,
            length: 10, // Placeholder, ideally from product data
            breadth: 10, // Placeholder, ideally from product data
            height: 10, // Placeholder, ideally from product data
            weight: 0.5, // Placeholder in kg, ideally from product data
        };

        const response = await axios.post('https://apiv2.shiprocket.in/v1/external/orders/create/adhoc', srPayload, {
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
            }
        });
        console.log(`Shiprocket order created for ${orderData.id}:`, response.data);
        return {
            shiprocket_order_id: response.data.order_id,
            tracking_id: response.data.shipping_id, // This might be AWB number
            tracking_url: `https://shiprocket.in/tracking/${response.data.shipping_id}`, // Generic tracking URL
            shiprocket_status: response.data.status, // e.g., 'NEW'
            message: 'Shiprocket order successfully created.'
        };
    } catch (error) {
        console.error('Failed to create Shiprocket order:', error.response ? error.response.data : error.message);
        return {
            shiprocket_order_id: null,
            tracking_id: null,
            tracking_url: null,
            shiprocket_status: 'FAILED',
            message: `Shiprocket order creation failed: ${error.response?.data?.message || error.message}`
        };
    }
}


