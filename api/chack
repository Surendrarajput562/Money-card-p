            token: ALLAPI_TOKEN,
            order_id: allapi_order_id, // AllAPI's unique order ID
            txn_amount: txn_amount,
            txn_note: txn_note,
            product_name: product_name,
            customer_name: customer_name,
            customer_mobile: customer_mobile,
            customer_email: customer_email,
            // Redirect URL can be a success page or dashboard, where frontend can check status
            redirect_url: `https://moneycard-8f457.web.app/index.html?paymentStatus=initiated&orderId=${internal_order_id}` 
        });

        if (allapiResponse.data.status) {
            // Update mapping with gateway transaction ID if available immediately
            await db.ref(`allapi_transactions_mapping/${allapi_order_id}`).update({
                gateway_txn_id: allapiResponse.data.results.txn_id,
                allapi_order_id: allapi_order_id // Store AllAPI's ID for clarity
            });

            return res.status(200).json({
                success: true,
                message: "Order created successfully with AllAPI.in",
                results: {
