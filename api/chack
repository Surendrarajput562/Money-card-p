app.post('/api/speed/swap', async (req, res) => {
    const { userId, amountUSD, fromAsset, toAsset } = req.body;
    try {
        const speedRes = await axios.post('https://api.tryspeed.com/balances/swap', {
            amount: amountUSD.toString(),
