async function confirmCheckout(){
    // Get/Save Address from Checkout form
    const house = document.getElementById('co-addr-house').value.trim();
    const city = document.getElementById('co-addr-city').value.trim();
    const district = document.getElementById('co-addr-district').value.trim();
    const country = document.getElementById('co-addr-country').value.trim();
    if(!house || !city || !district || !country) return alert('Please fill all delivery address fields.');

    const addr = {house,city,district,country};

    try {
        await db.ref('users/'+currentUser.uid+'/address').set(addr); // 1. Save Address

        const orderId = 'o'+Date.now();
        const subtotalEl = document.getElementById('cart-subtotal');
        const subtotal = Number(subtotalEl ? subtotalEl.innerText : 0) || 0;

        if(subtotal === 0) return alert('Your cart is empty. Please add items to proceed.');
        
        const detailedItems = {};
        let productNamesForGateway = [];
        Object.keys(cart).forEach(cartKey => {
            const cartItem = cart[cartKey];
            const pid = cartItem.productId;

            if(!pid) {
                console.error("Cart Item Missing Product ID:", cartItem);
                throw new Error(`Invalid item found in cart (Key: ${cartKey}). productId is missing.`);
            }

            const p = productsData[pid];

            if(!p) {
                throw new Error(`Product data missing for item ID: ${pid}. Please reload products or check the ID.`);
            }

            detailedItems[cartKey] = {
                id: pid,
                name: p.name,
                quantity: cartItem.qty,
                price: Number(p.price),
                discount: Number(p.discount || 0),
                final_price: calcDiscountPrice(p.price, p.discount),
                image: (p.images && p.images[0]) || 'https://via.placeholder.com/100',
                color: cartItem.color || '—',
                size: cartItem.size || '—'
            };
            productNamesForGateway.push(`${p.name} x${cartItem.qty}`);
        });

        // Prepare order data for Firebase (initial status)
        const orderDataForFirebase = {
            id: orderId,
            user: currentUser.uid,
            items: detailedItems,
            total: subtotal,
            address: addr,
            status: 'payment_pending', // Initial status
            created_at: Date.now()
        };

        // Call backend API to create an order with AllAPI.in
        const response = await axios.post(`${backendUrl}/api/create-order`, {
            user_id: currentUser.uid,
            internal_order_id: orderId, // Your internal orderId
            txn_amount: subtotal,
            txn_note: `Payment for Order ${orderId.substring(0,8)}...`,
            product_name: `Items: ${productNamesForGateway.join(', ')}`,
            customer_name: document.getElementById('profile-name-display').innerText || 'User',
            customer_mobile: document.getElementById('profile-mobile-display').innerText || 'N/A',
            customer_email: currentUser.email || 'N/A',
            type: 'cart', // Custom field for your backend to identify transaction type
        });

        if (response.data.success) {
            const { allapi_order_id, payment_url, upi_intent } = response.data.results;
            
            // Save initial order status to Firebase (will be updated by webhook later)
            await db.ref('orders/'+orderId).set(orderDataForFirebase);
            await db.ref('users/'+currentUser.uid+'/order_history/'+orderId).set(orderDataForFirebase);
            
            // Save the mapping for webhook to use
            await allapiTransactionsMappingRef.child(allapi_order_id).set({
                internal_id: orderId,
                user_id: currentUser.uid,
                type: 'cart'
            });

            closeCheckoutModal(); // Close checkout modal
            openPaymentLinkModal(`Pay for Order`, orderId, payment_url, upi_intent);
        } else {
            alert(`Payment initiation failed: ${response.data.message}`);
        }

    } catch(error) {
        console.error("🔥 CHECKOUT FAILED:", error);
        alert(`❌ Order submission failed. Please try again. \nReason: ${error.response?.data?.message || error.message}`);
    }
}


        
