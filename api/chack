                if(cat && p.category!==cat) return false;
                if(!q) return true;
                const text = `${p.name} ${p.description} ${p.brand||''} ${p.colors_list.join(' ')} ${p.sizes_list.join(' ')} ${p.category||''}`.toLowerCase();
